# --- Supabase (proyecto de Teia) ---------------------------------------------
# La service_role key es SECRETA y bypassa RLS: va SOLO en las env vars de Vercel,
# NUNCA en el repo ni en el cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel /administradora ---------------------------------------------------
# Clave que usa Teia para entrar al panel (la elige ella).
TEIA_ADMIN_PASSWORD=

# --- Secreto de firma de sesión ----------------------------------------------
# Firma la cookie de sesión del cliente. Tiene que ser SU PROPIA env (no se reusa la de la
# base): así rotar la credencial de Supabase no cierra todas las sesiones, y filtrar una no
# alcanza a la otra. Cualquier string largo al azar (ej. `openssl rand -hex 32`). Al cargarla
# por primera vez, las sesiones vivas se piden de nuevo una vez (re-login) — es esperado.
TEIA_SESSION_SECRET=

# --- Tienda -------------------------------------------------------------------
# (El pedido mínimo YA NO EXISTE. Pasó a ser el umbral de ENVÍO SIN CARGO, que no bloquea
#  ningún pedido y se edita desde el panel → pestaña "Envíos". Vive en la tabla
#  teia_settings, claves envio_min_general / envio_min_chungo. La vieja TEIA_MIN_ORDER no la
#  lee nadie: si la tenés cargada en Vercel, borrala.)

# WhatsApp de Teia (solo dígitos, con código de país). Se usa en la puerta, para que el
# CUIT no habilitado pueda pedir el alta, y en el mensaje de acceso del panel.
TEIA_WHATSAPP=5491131019238

# URL pública de la app (para el mensaje de acceso que se manda por WhatsApp).
TEIA_APP_URL=

# --- 2º factor de entrada: CUIT + contraseña ----------------------------------
# El CUIT de un comercio es un dato PÚBLICO (facturas, constancia de AFIP), así que por sí
# solo no protege los precios. Con el 2º factor encendido se pide además la contraseña que
# la administradora le escribió al cliente.
#
# ⚠️ ESTA VARIABLE ES SOLO UN RESPALDO. El interruptor de verdad está EN EL PANEL
# (Clientes → "Pedir contraseña"), guardado en teia_settings.require_code: se prende sin
# redeploy y con una guarda que avisa qué cuentas quedarían afuera. Esta env var solo manda
# si esa tabla todavía no existe.
# ⚠️ Al encenderlo, una cuenta SIN contraseña cargada no puede entrar (falla cerrado), y no
# se nota en el momento: las sesiones abiertas duran 90 días.
TEIA_REQUIRE_CODE=

# --- Barrido nocturno (/api/cron/sweep) ---------------------------------------
# REQUERIDA en prod: el cron es fail-closed. Vercel manda `Authorization: Bearer <secret>` en
# cada corrida y el endpoint la exige. Sin esta var el cron devuelve 401 y NO corre → sin
# barrido de archivados fallidos, sin espejo nocturno y sin keep-alive → Supabase se pausa a
# los ~7 días. Cualquier string largo al azar (`openssl rand -hex 32`).
CRON_SECRET=

# --- Aviso de pedido nuevo por mail (Resend) ----------------------------------
# Si faltan RESEND_API_KEY o TEIA_ALERT_EMAIL, no se manda aviso y no rompe (degrada como el
# resto de las integraciones). El dominio del remitente tiene que estar verificado en Resend.
RESEND_API_KEY=
TEIA_ALERT_EMAIL=              # destinatario(s); varios separados por coma
TEIA_ALERT_FROM=              # opcional; default: Teia Bakery <pedidos@kyndredai.com>

# --- Aviso de pedido nuevo al CELULAR (notificación push de la app instalada) ---------------
# Se generan una sola vez con `node scripts/vapid-keys.mjs`. Sin ellas no se manda ningún aviso
# y no rompe nada (degrada como el resto de las integraciones).
# La PRIVADA es SECRETA: marcarla "Sensitive" en Vercel. Rotarla obliga a que cada teléfono
# vuelva a activar los avisos desde el panel.
# ⚠️ Requiere además la tabla `teia_push_subs` (está en supabase/schema.sql) y que la
# administradora active los avisos con el botón del panel, desde la app YA INSTALADA.
TEIA_VAPID_PUBLIC_KEY=
TEIA_VAPID_PRIVATE_KEY=

# --- Espejo Google Sheet + Drive (OAuth de la cuenta de la clienta) -------------
# OAuth Client de Google Cloud (APIs: Drive + Sheets; scope drive.file; redirect URI:
# https://<dominio>/api/admin/google/callback). El REFRESH_TOKEN sale del botón
# "Conectar Google" del panel — al hacer el handoff se re-consiente con la cuenta de la
# clienta y solo se reemplaza ese token: la carpeta y la planilla se auto-crean en su Drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
