      {/* Acceso al diagnóstico técnico. Va acá porque la app INSTALADA no tiene barra de
          direcciones: sin un enlace adentro, no hay forma de llegar a ?diag=1 desde la app, y
          justamente lo que hay que medir es cómo se comporta ADENTRO de la app.
          Chiquito y al final: Mica no tiene por qué entender qué es, y no le estorba. */}
      <p class="diag-link"><a href="/administradora?diag=1">diagnóstico técnico</a></p>

      {/* Recortador de fotos. Va como hermano de las secciones, NO adentro de una: showTab()
          esconde todo [data-panel] que no sea el activo, asi que anidado aca adentro el modal
          quedaria invisible al abrirlo desde "Nuevo producto". */}
      <div class="cropper" id="cropper" hidden>
        <div class="cropper__card" role="dialog" aria-modal="true" aria-label="Encuadrar la foto">
          <h2 class="cropper__t">Elegí qué parte se ve</h2>
          <p class="cropper__hint">Arrastrá la foto para moverla y usá la barra para acercarla.</p>
          <div class="cropper__vista">
            <canvas id="cropLienzo"></canvas>
            <div class="cropper__marco" aria-hidden="true"></div>
          </div>
          <div class="cropper__zoom">
            <span aria-hidden="true">−</span>
            <input type="range" id="cropZoom" min="1" max="4" step="0.01" value="1" aria-label="Acercar" />
            <span aria-hidden="true">+</span>
          </div>
          <div class="cropper__pies">
            <button class="btn btn--ghost" type="button" id="cropCancel">Cancelar</button>
            <button class="btn" type="button" id="cropOk">Usar este encuadre</button>
          </div>
          <p class="cropper__msg muted" id="cropMsg"></p>
        </div>
      </div>

  </div>

  <script>
    // ---- globo del ícono con los pedidos pendientes ----
    // Abrir el panel pone el globo en el número REAL de pedidos que esperan acción (no lo borra
    // por el solo hecho de abrirlo): si entra, mira y no confirma nada, el recordatorio sigue.
    // Al confirmar o borrar un pedido la página recarga y el número baja solo.
    //
    // Callado mientras todo va bien: solo habla si está en la app instalada y AHÍ falla,
    // que es lo único accionable. Pero sin TRAGARSE el error como al principio, cuando un
    // `.catch(() => {})` dejó el problema invisible.
    (async () => {
      const aviso = document.getElementById('badgeEstado');
      const decir = (t) => { if (aviso) { aviso.textContent = t; aviso.hidden = false; } };
      const wrap = document.querySelector('.admin-wrap');
      // Vacío = el servidor no pudo contar. En ese caso NO se pinta nada al abrir: poner 0
      // borraría el globo diciéndole que no tiene pedidos, que es la peor mentira posible acá.
      const crudo = wrap?.dataset.pendientes ?? '';
      let pintados = crudo === '' ? null : Number(crudo);

      const instalada =
        window.matchMedia('(display-mode: standalone)').matches ||
        ('standalone' in navigator && navigator.standalone === true);

      // ── DIAGNOSTICO, detras de ?diag=1 ────────────────────────────────────────────────────
      // Va ANTES de cualquier guarda, a proposito. La primera version estaba adentro del
      // `return` de abajo: si setAppBadge no existia --justo el caso que se quiere diagnosticar--
      // el bloque salia antes y el diagnostico nunca corria. Un diagnostico que solo funciona
      // cuando no hace falta no sirve para nada.
      // Detras de ?diag=1 para que Mica no lo vea nunca: son datos para el que programa.
      if (new URLSearchParams(location.search).get('diag') === '1') {
        const hechos = {
          appInstalada: instalada,
          apiEnLaPagina: 'setAppBadge' in navigator,
          apiEnElWorker: 'sin respuesta',
          intentoDePintar: 'no se intento',
          pendientes: crudo === '' ? 'no se pudo contar' : crudo,
        };
        try {
          const reg = await navigator.serviceWorker?.getRegistration();
          if (reg && reg.active) {
            hechos.apiEnElWorker = await new Promise((res) => {
              const canal = new MessageChannel();
              const t = setTimeout(() => res('sin respuesta en 2s'), 2000);
              canal.port1.onmessage = (e) => { clearTimeout(t); res(String(e.data?.apiEnWorker) + ' (' + e.data?.version + ')'); };
              reg.active.postMessage({ tipo: 'globo?' }, [canal.port2]);
            });
          } else { hechos.apiEnElWorker = 'no hay worker activo'; }
        } catch (e) { hechos.apiEnElWorker = 'error: ' + e; }

        if ('setAppBadge' in navigator) {
          // ⚠️ Se pinta un 7 A PROPOSITO, no el numero real.
          // La primera version hacia `Number(crudo) || 1`, y como el cero es FALSO en JavaScript,
          // con 0 pendientes pintaba un 1 inventado: el diagnostico mostraba un globo que no
          // correspondia a nada. Y con el numero real tampoco sirve, porque si es 0 la llamada
          // BORRA el globo y no se puede ver si funciona.
          // Un 7 fijo prueba lo unico que interesa: que el sistema dibuje algo en el icono.
          try {
            await Promise.race([
              navigator.setAppBadge(7),
              new Promise((_, rej) => setTimeout(() => rej(new Error('NO RESPONDIO en 2s (queda colgado)')), 2000)),
            ]);
            hechos.intentoDePintar = 'OK — mira el icono: tiene que decir 7 (es de prueba)';
          } catch (e) { hechos.intentoDePintar = 'FALLO: ' + (e && e.name ? e.name + ' — ' : '') + (e && e.message || e); }
        }

        if (aviso) {
          aviso.hidden = false;
          aviso.style.whiteSpace = 'pre-line';
          aviso.style.fontFamily = 'monospace';
          aviso.textContent = Object.entries(hechos).map(([k, v]) => k + ': ' + v).join(String.fromCharCode(10));
          const volver = document.createElement('a');
          volver.href = '/administradora';
          volver.textContent = '← volver al panel (deja el globo en el número real)';
          volver.style.cssText = 'display:inline-block;margin-top:8px;font-family:inherit';
          aviso.appendChild(document.createElement('br'));
          aviso.appendChild(volver);
        }
        return; // en modo diagnostico no se sigue: no queremos que otro camino pise el resultado
      }

      // El globo es un extra de la app instalada. Abierto en el navegador NO tiene por qué haberlo,
      // así que no se dice nada: un cartel técnico permanente en el panel es ruido para Mica.
      // Solo se avisa si está en la app instalada Y ahí falla, que es lo único accionable.
      if (!instalada || !('setAppBadge' in navigator)) return;

      const pintar = async (n) => {
        try {
          if (n > 0) await navigator.setAppBadge(n); else await navigator.clearAppBadge();
          // OJO: que la llamada resuelva NO garantiza que se vea — en una pestaña común resuelve
          // igual sin dibujar nada. Por eso no se anuncia ningún éxito, solo se reportan fallas.
        } catch (e) {
          decir('Globo del ícono: no se pudo. Motivo: ' + ((e && e.name ? e.name + ' — ' : '') + (e && e.message || e)));
        }
      };
      if (pintados !== null) await pintar(pintados);

      // ── Repintar al volver a la app ────────────────────────────────────────────────────────
      // El push solo llega cuando entra un pedido. Si Mica confirma uno desde el celular, la app
      // de la computadora se queda con el número viejo para siempre. Y al revés.
      // Cada vez que vuelve a mirar la app se recuenta contra el servidor. `pageshow` además cubre
      // el iPhone, que al volver a una app abierta no recarga la página (la saca del bfcache).
      let ultima = 0;
      const resincronizar = async () => {
        if (document.visibilityState !== 'visible') return;
        if (Date.now() - ultima < 10000) return; // sin martillar el servidor en cada foco
        ultima = Date.now();
        try {
          const r = await fetch('/api/admin/pendientes', { headers: { 'Accept': 'application/json' } });
          if (!r.ok) return;
          const o = await r.json();
          // null = "no se pudo contar". No saber NO puede borrarle el globo.
          if (typeof o.pendientes !== 'number') return;
          if (o.pendientes !== pintados) {
            pintados = o.pendientes;
            await pintar(pintados);
            // El globo dice 3 y la lista de abajo sigue mostrando 2: eso es peor que no tener
            // globo. Se ofrece recargar en vez de hacerlo solo, que le tiraría una edición a medias.
            if (aviso) {
              aviso.textContent = 'Entraron pedidos nuevos. Tocá acá para actualizar la lista.';
              aviso.hidden = false;
              aviso.style.cursor = 'pointer';
              aviso.onclick = () => location.reload();
            }
          }
        } catch { /* sin red: se queda con el número que tenía */ }
      };
      document.addEventListener('visibilitychange', resincronizar);
      window.addEventListener('pageshow', resincronizar);

      // ── El globo, pintado desde la PAGINA cuando llega un aviso ──────────────────────────
      // En iPhone el service worker no puede pintarlo (Safari no expone setAppBadge ahi dentro).
      // Cuando llega un push, el worker le avisa a esta pagina y lo pinta ella. Funciona con la
      // app en segundo plano, que es el caso normal: ella la abre y la deja atras.
      navigator.serviceWorker?.addEventListener('message', async (e) => {
        if (!e.data || e.data.tipo !== 'globo') return;
        if (typeof e.data.pendientes !== 'number') return;
        pintados = e.data.pendientes;
        await pintar(pintados);
      });

      // Diagnostico: se le pregunta al worker si el globo existe alla adentro. Solo se dice algo
      // si NO existe, porque en ese caso el numero aparece recien al abrir la app y conviene que
      // se sepa en vez de esperarlo para siempre.
      try {
        const reg = await navigator.serviceWorker?.getRegistration();
        const activo = reg && reg.active;
        if (activo) {
          const canal = new MessageChannel();
          canal.port1.onmessage = (e) => {
            if (e.data && e.data.apiEnWorker === false) {
              decir('En este teléfono el número sobre el ícono se actualiza al abrir la app, no al llegar el aviso. Es un límite del sistema, no una falla.');
            }
          };
          activo.postMessage({ tipo: 'globo?' }, [canal.port2]);
        }
      } catch (e) { /* diagnostico opcional */ }
    })();

    // ---- salir del panel ----
    // Va por fetch con JSON (no un form): detrás del proxy de Vercel, el checkOrigin de Astro
    // rechaza los POST con content-type de formulario aunque salgan del propio sitio.
    document.getElementById('salirPanel')?.addEventListener('click', async (e) => {
      const b = e.currentTarget;
      b.disabled = true; b.textContent = 'Saliendo…';
      try {
        await fetch('/api/admin/salir', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      } catch {}
      location.href = '/administradora';
    });

    // ---- tabs ----
    const showTab = (name) => {
      document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('is-active', t.dataset.tab === name));
      document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== name));
    };
    document.querySelectorAll('.tab').forEach((t) =>
      t.addEventListener('click', () => {
        if (t.dataset.tab === 'nuevo') resetForm();
        showTab(t.dataset.tab);
        history.replaceState(null, '', '#' + t.dataset.tab);
      })
    );

    // ---- confirmar pedido ----
    document.querySelectorAll('.confirm').forEach((b) =>
      b.addEventListener('click', async () => {
        b.disabled = true; // doble click acá = stock descontado dos veces
        b.textContent = '…';
        const r = await fetch('/api/admin/confirm', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          // Los montos viajan CON el confirm: es la secuencia que usa Mica (los escribe y toca
          // Confirmar). El remito se genera adentro de ese endpoint, así que si no fueran acá
          // saldría con los renglones en blanco.
          body: JSON.stringify({
            id: b.dataset.id,
            saldo_anterior: b.closest('.ordcard')?.querySelector('.of-saldo')?.value ?? '',
            costo_envio: b.closest('.ordcard')?.querySelector('.of-envio')?.value ?? '',
          }),
        });
        if (r.ok) {
          // El server avisa si el pedido superaba el stock o si algo quedó bajo el mínimo —
          // antes esta respuesta se descartaba y la sobreventa era invisible.
          const o = await r.json().catch(() => ({}));
          const avisos = [];
          if (o.shortages && o.shortages.length) avisos.push('⚠️ STOCK INSUFICIENTE (quedó en 0):\n· ' + o.shortages.join('\n· '));
          if (o.low_stock && o.low_stock.length) avisos.push('Queda poco stock: ' + o.low_stock.join(', '));
          if (avisos.length) alert('Pedido confirmado.\n\n' + avisos.join('\n\n'));
          location.reload();
        } else { b.textContent = 'Error — reintentá'; b.disabled = false; }
      })
    );

    // ---- reintentar archivado de remitos ----
    document.querySelectorAll('.retry-arch').forEach((b) =>
      b.addEventListener('click', async () => {
        b.textContent = 'Archivando…'; b.disabled = true;
        const r = await fetch('/api/admin/archive', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          // Los montos viajan CON el confirm: es la secuencia que usa Mica (los escribe y toca
          // Confirmar). El remito se genera adentro de ese endpoint, así que si no fueran acá
          // saldría con los renglones en blanco.
          body: JSON.stringify({
            id: b.dataset.id,
            saldo_anterior: b.closest('.ordcard')?.querySelector('.of-saldo')?.value ?? '',
            costo_envio: b.closest('.ordcard')?.querySelector('.of-envio')?.value ?? '',
          }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Reintentar'; b.disabled = false; alert('No se pudo archivar. Probá de nuevo.'); }
      })
    );

    // ---- form producto + vista previa en vivo ----
    const form = document.getElementById('pform');
    const F = (n) => form.elements.namedItem(n); // robusto: evita el shadowing de form.name / form.id
    const fileInput = document.getElementById('pfile');
    const fileBtn = document.getElementById('pfilebtn');
    const msg = document.getElementById('pmsg');
    const money = (n) => '$' + Number(n || 0).toLocaleString('es-AR');

    // Redimensiona/comprime la imagen en el navegador antes de subir (evita el límite de 4,5MB
    // de Vercel y hace el catálogo más liviano). Si algo falla, devuelve el archivo original.
    async function resizeImage(file, maxDim = 1400, quality = 0.85) {
      try {
        const bitmap = await createImageBitmap(file);
        let w = bitmap.width, h = bitmap.height;
        if (Math.max(w, h) > maxDim) { const s = maxDim / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);
        if (bitmap.close) bitmap.close();
        const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', quality));
        if (!blob) return file;
        const base = (file.name || 'foto').replace(/\.[^.]+$/, '') || 'foto';
        return new File([blob], base + '.jpg', { type: 'image/jpeg' });
      } catch { return file; }
    }

    function updatePreview() {
      const name = F('name').value.trim();
      const desc = F('description') ? F('description').value.trim() : '';
      const cat = F('category').value.trim();
      const pack = F('pack_label').value.trim();
      const stock = Number(F('stock').value) || 0;
      const active = F('active') ? F('active').checked : true;
      const file = fileInput && fileInput.files && fileInput.files[0];
      const imgSrc = file ? URL.createObjectURL(file) : F('image_url').value.trim();

      const set = (id, txt) => { const e = document.getElementById(id); if (e) e.textContent = txt; };
      set('pv-name', name || 'Nombre del producto');
      set('pv-cat', cat || '—');
      set('pv-price', money(F('price').value));
      set('pv-initial', (name.charAt(0) || '?').toUpperCase());
      const dEl = document.getElementById('pv-desc'); dEl.textContent = desc; dEl.hidden = !desc;
      const pEl = document.getElementById('pv-pack'); pEl.textContent = pack; pEl.hidden = !pack;
      const img = document.getElementById('pv-img');
      if (imgSrc) { img.src = imgSrc; img.hidden = false; } else { img.hidden = true; img.removeAttribute('src'); }
      document.getElementById('pv-buy').innerHTML = stock > 0
        ? '<div class="stepper"><span class="step-btn">−</span><span class="qty">0</span><span class="step-btn">+</span></div>'
        : '<span class="badge-out">Sin stock</span>';
      document.getElementById('pv-item').classList.toggle('is-hidden', !active);
      document.getElementById('pv-hidden').hidden = active;
    }

    function fillForm(p) {
      // si el rubro del producto no está en el dropdown (fue borrado), lo agregamos como opción
      const catSel = F('category');
      if (catSel && p.category && !Array.from(catSel.options).some((o) => o.value === p.category)) {
        catSel.add(new Option(p.category, p.category));
      }
      ['id', 'name', 'description', 'category', 'catalog', 'image_url', 'pack_label', 'price', 'stock', 'low_stock_threshold'].forEach((k) => {
        const el = F(k); if (el) el.value = p[k] ?? '';
      });
      if (F('active')) F('active').checked = p.active !== false;
      if (fileInput) fileInput.value = '';
      if (fileBtn) fileBtn.textContent = '📷 Subir foto';
      updatePreview();
    }
    function resetForm() {
      form.reset();
      document.getElementById('formTitle').textContent = 'Nuevo producto';
      if (fileInput) fileInput.value = '';
      if (fileBtn) fileBtn.textContent = '📷 Subir foto';
      msg.textContent = '';
      updatePreview();
    }

    document.querySelectorAll('.editp').forEach((b) =>
      b.addEventListener('click', () => {
        fillForm(JSON.parse(b.dataset.p));
        document.getElementById('formTitle').textContent = 'Editar producto';
        showTab('nuevo');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      })
    );

    // "Copiar a <otro catálogo>": clona el producto al otro catálogo como NUEVO (id vacío) y
    // deja el form listo con el precio enfocado. Mica solo cambia el precio y guarda — así no
    // tiene que recargar a mano el mismo producto en el catálogo VIP.
    document.querySelectorAll('.copy-prod').forEach((b) =>
      b.addEventListener('click', () => {
        let p; try { p = JSON.parse(b.dataset.p); } catch { return; }
        // Antes esto creaba una segunda fila en silencio si el producto ya existía del otro lado.
        // Ahora se avisa: duplicar es casi siempre un accidente, y el que lo paga es el comercio,
        // que ve el mismo producto dos veces en su catálogo.
        if (p.yaEstaEnLaOtra && !confirm(
          '"' + p.name + '" ya existe en ' + (b.dataset.targetLabel || 'la otra lista') + '.' +
          String.fromCharCode(10) + String.fromCharCode(10) +
          'Si lo copiás igual, va a quedar dos veces y tus clientes lo van a ver repetido.' +
          String.fromCharCode(10) + '¿Copiar de todas formas?')) return;
        fillForm({ ...p, id: '', catalog: b.dataset.target });
        document.getElementById('formTitle').textContent =
          'Copia para ' + (b.dataset.targetLabel || 'el otro catálogo') + ' — ajustá el precio y guardá';
        showTab('nuevo');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        const price = document.getElementById('pf-price');
        if (price) { price.focus(); price.select(); }
      })
    );

    document.querySelectorAll('.del-prod').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm('¿Borrar el producto "' + b.dataset.name + '"? No se puede deshacer.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/product', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: b.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      })
    );

    fileInput?.addEventListener('change', () => {
      const f = fileInput.files && fileInput.files[0];
      if (fileBtn) fileBtn.textContent = f ? '✓ Foto lista' : '📷 Subir foto';
      updatePreview();
    });
    form.addEventListener('input', updatePreview);
    document.getElementById('pclear').addEventListener('click', resetForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'muted';
      let image_url = F('image_url').value.trim();
      const file = fileInput && fileInput.files && fileInput.files[0];

      // 1) subir la imagen si eligió un archivo: se comprime y se manda como BASE64 en JSON
      //    (NO multipart — Vercel bloquea el multipart con 403 vía WAF).
      let image_original_url = '';
      if (file) {
        msg.textContent = 'Procesando imagen…';
        // Si eligió encuadre, lo que ve el cliente es el RECORTE; la foto entera se guarda
        // aparte para poder reencuadrar más adelante sin perder calidad.
        if (recorteNuevo) {
          const entera = await resizeImage(file);
          image_original_url = (await subirImagen(entera)) || '';
        }
        const toUpload = recorteNuevo || await resizeImage(file);
        const dataUrl = await new Promise((res) => {
          const rd = new FileReader(); rd.onload = () => res(rd.result); rd.onerror = () => res(''); rd.readAsDataURL(toUpload);
        });
        if (!dataUrl) { msg.textContent = 'No se pudo leer la imagen.'; return; }
        msg.textContent = 'Subiendo imagen…';
        let up, uo;
        try {
          up = await fetch('/api/admin/upload', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contentType: toUpload.type, data: dataUrl }),
          });
          uo = await up.json().catch(() => ({}));
        } catch { msg.textContent = 'No se pudo conectar para subir la imagen.'; return; }
        if (up.ok && uo.url) image_url = uo.url;
        else { msg.textContent = (uo && uo.error) || ('No se pudo subir la imagen (código ' + (up ? up.status : '?') + ').'); return; }
      }

      // 2) guardar el producto
      msg.textContent = 'Guardando…';
      const payload = {
        id: F('id').value,
        name: F('name').value.trim(),
        description: F('description').value.trim(),
        category: F('category').value.trim(),
        catalog: F('catalog') ? F('catalog').value : 'general',
        image_url,
        ...(image_original_url ? { image_original_url } : {}),
        pack_label: F('pack_label').value.trim(),
        price: F('price').value,
        stock: F('stock').value,
        low_stock_threshold: F('low_stock_threshold').value,
        active: F('active') ? F('active').checked : true,
      };
      const r = await fetch('/api/admin/product', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
      if (r.ok) {
        const editing = !!F('id').value;
        msg.className = 'ok-msg';
        msg.textContent = editing ? '✓ Producto actualizado' : '✓ ¡Producto agregado!';
        // Volver a la fila que acaba de tocar, no al principio de la lista.
        recordarProducto(F('id').value || '');
        setTimeout(() => { location.hash = 'productos'; location.reload(); }, 950);
      } else {
        const o = await r.json().catch(() => ({}));
        msg.textContent = (o && o.error) || 'Error al guardar.';
      }
    });

    // ---- editar un pedido (datos + cantidades) ----
    /** Sube un File/Blob a Storage y devuelve la URL, o null. Se usa para el recorte y para
     *  la foto original (que se guarda aparte para poder reencuadrar sin perder calidad). */
    async function subirImagen(file) {
      const dataUrl = await new Promise((res) => {
        const rd = new FileReader(); rd.onload = () => res(rd.result); rd.onerror = () => res(''); rd.readAsDataURL(file);
      });
      if (!dataUrl) return null;
      try {
        const r = await fetch('/api/admin/upload', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contentType: file.type || 'image/jpeg', data: dataUrl }),
        });
        const o = await r.json().catch(() => ({}));
        return r.ok && o.url ? o.url : null;
      } catch { return null; }
    }

    // ══ RECORTADOR DE FOTOS ═════════════════════════════════════════════════════════════════
    // Pedido de Mica: "poder elegir el plano", como cuando recortás una captura en el celular o
    // ponés una foto de perfil en WhatsApp. Arrastrar para mover, pellizcar o barra para el zoom.
    //
    // Escrito a mano con canvas y eventos de puntero: la política de seguridad del sitio
    // (script-src 'self') no deja cargar ninguna librería de un CDN.
    //
    // El recorte es CUADRADO porque la miniatura del catálogo es cuadrada: lo que ella encuadra
    // es exactamente lo que se ve. Con recorte libre, la grilla volvería a cortar la foto sola —
    // que es el problema que quiso resolver.
    //
    // Y cada recorte se hace SIEMPRE desde la foto ORIGINAL, nunca desde el último recorte: si no,
    // cada ajuste perdería calidad y nunca podría volver a abrir el encuadre.
    const cropper = (() => {
      const caja = document.getElementById('cropper');
      const lienzo = document.getElementById('cropLienzo');
      const zoom = document.getElementById('cropZoom');
      const cmsg = document.getElementById('cropMsg');
      if (!caja || !lienzo) return null;

      const LADO = 300;          // el cuadrado que se ve en pantalla
      const SALIDA = 900;        // el lado del archivo que se sube
      const ctx = lienzo.getContext('2d');
      let img = null, escala = 1, offx = 0, offy = 0, base = 1;
      let alGuardar = null;      // qué hacer con el recorte (lo pone quien lo abre)

      const dpr = () => Math.min(window.devicePixelRatio || 1, 2);
      function medir() {
        lienzo.width = LADO * dpr(); lienzo.height = LADO * dpr();
        lienzo.style.width = LADO + 'px'; lienzo.style.height = LADO + 'px';
      }

      // Límites: la foto SIEMPRE tiene que tapar el cuadrado. Sin esto quedan franjas vacías y
      // el producto sale con bordes blancos en el catálogo.
      function acotar() {
        const dw = img.naturalWidth * base * escala, dh = img.naturalHeight * base * escala;
        const mx = Math.max(0, (dw - LADO) / 2), my = Math.max(0, (dh - LADO) / 2);
        offx = Math.min(mx, Math.max(-mx, offx));
        offy = Math.min(my, Math.max(-my, offy));
      }

      function pintar() {
        if (!img) return;
        const k = dpr();
        ctx.setTransform(k, 0, 0, k, 0, 0);
        ctx.clearRect(0, 0, LADO, LADO);
        const dw = img.naturalWidth * base * escala, dh = img.naturalHeight * base * escala;
        ctx.drawImage(img, (LADO - dw) / 2 + offx, (LADO - dh) / 2 + offy, dw, dh);
      }

      // ---- arrastre y pellizco, con eventos de puntero (sirve para dedo y para mouse) ----
      const punteros = new Map();
      let dist0 = 0, escala0 = 1;
      lienzo.addEventListener('pointerdown', (e) => {
        lienzo.setPointerCapture(e.pointerId);
        punteros.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (punteros.size === 2) {
          const [a, b] = [...punteros.values()];
          dist0 = Math.hypot(a.x - b.x, a.y - b.y); escala0 = escala;
        }
      });
      lienzo.addEventListener('pointermove', (e) => {
        const prev = punteros.get(e.pointerId);
        if (!prev) return;
        e.preventDefault();
        if (punteros.size === 2) {
          punteros.set(e.pointerId, { x: e.clientX, y: e.clientY });
          const [a, b] = [...punteros.values()];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist0 > 0) {
            escala = Math.min(4, Math.max(1, escala0 * (d / dist0)));
            zoom.value = String(escala);
            acotar(); pintar();
          }
          return;
        }
        offx += e.clientX - prev.x; offy += e.clientY - prev.y;
        punteros.set(e.pointerId, { x: e.clientX, y: e.clientY });
        acotar(); pintar();
      });
      const soltar = (e) => { punteros.delete(e.pointerId); dist0 = 0; };
      lienzo.addEventListener('pointerup', soltar);
      lienzo.addEventListener('pointercancel', soltar);
      lienzo.addEventListener('wheel', (e) => {
        e.preventDefault();
        escala = Math.min(4, Math.max(1, escala * (e.deltaY < 0 ? 1.08 : 0.93)));
        zoom.value = String(escala); acotar(); pintar();
      }, { passive: false });
      zoom.addEventListener('input', () => { escala = Number(zoom.value) || 1; acotar(); pintar(); });

      function cerrar() { caja.hidden = true; img = null; alGuardar = null; cmsg.textContent = ''; }
      document.getElementById('cropCancel').addEventListener('click', cerrar);
      caja.addEventListener('click', (e) => { if (e.target === caja) cerrar(); });

      document.getElementById('cropOk').addEventListener('click', async () => {
        if (!img || !alGuardar) return;
        const fuera = document.createElement('canvas');
        fuera.width = SALIDA; fuera.height = SALIDA;
        const f = SALIDA / LADO;
        const c2 = fuera.getContext('2d');
        c2.fillStyle = '#FFFDF8'; c2.fillRect(0, 0, SALIDA, SALIDA);
        const dw = img.naturalWidth * base * escala * f, dh = img.naturalHeight * base * escala * f;
        c2.drawImage(img, (SALIDA - dw) / 2 + offx * f, (SALIDA - dh) / 2 + offy * f, dw, dh);
        const blob = await new Promise((res) => fuera.toBlob(res, 'image/jpeg', 0.88));
        if (!blob) { cmsg.textContent = 'No se pudo generar el recorte.'; return; }
        const fn = alGuardar;
        cerrar();
        await fn(new File([blob], 'recorte.jpg', { type: 'image/jpeg' }));
      });

      /** Abre el recortador sobre `src`. `alGuardarFn` recibe el File del recorte. */
      async function abrir(src, alGuardarFn) {
        return new Promise((res, rej) => {
          const im = new Image();
          // crossOrigin es OBLIGATORIO para las fotos ya subidas: sin esto el canvas queda
          // "contaminado" y toDataURL/toBlob tiran SecurityError. Supabase Storage manda
          // Access-Control-Allow-Origin: * (verificado), así que funciona.
          if (!/^blob:|^data:/.test(src)) im.crossOrigin = 'anonymous';
          im.onload = () => {
            img = im; escala = 1; offx = 0; offy = 0;
            base = Math.max(LADO / im.naturalWidth, LADO / im.naturalHeight);
            zoom.value = '1';
            alGuardar = alGuardarFn;
            caja.hidden = false;
            medir(); acotar(); pintar();
            res(true);
          };
          im.onerror = () => rej(new Error('no se pudo cargar la imagen'));
          im.src = src;
        });
      }
      return { abrir };
    })();

    // ---- entrada 1: al elegir una foto nueva en "Nuevo producto" ----
    // El encuadre se elige AL SUBIR, no después: si no, la foto entra recortada por el CSS y ella
    // recién ve el problema cuando el producto ya está publicado.
    let recorteNuevo = null;   // File del recorte, si eligió encuadre
    if (fileInput && cropper) {
      fileInput.addEventListener('change', async () => {
        const f = fileInput.files && fileInput.files[0];
        recorteNuevo = null;
        if (!f) return;
        const url = URL.createObjectURL(f);
        try {
          await cropper.abrir(url, async (recorte) => {
            recorteNuevo = recorte;
            const img = document.getElementById('pv-img');
            if (img) { img.src = URL.createObjectURL(recorte); img.hidden = false; }
            if (fileBtn) fileBtn.textContent = '✂️ Encuadrada — tocá para cambiar';
          });
        } catch { /* si no se pudo abrir, se sube la foto entera como siempre */ }
      });
    }

    // ---- entrada 2: encuadrar una foto YA cargada, desde la lista de productos ----
    document.querySelectorAll('.recortar').forEach((b) => {
      b.addEventListener('click', async () => {
        if (!cropper) return;
        const id = b.dataset.id, src = b.dataset.src;
        if (!src) return;
        const rotulo = b.textContent;
        try {
          await cropper.abrir(src, async (recorte) => {
            b.textContent = 'Subiendo…'; b.disabled = true;
            // La ORIGINAL se guarda la primera vez: a partir de ahí todo reencuadre parte de
            // ella y no del recorte anterior, así la foto no se degrada con cada ajuste.
            const urlRecorte = await subirImagen(recorte);
            if (!urlRecorte) { alert('No se pudo subir el recorte. Probá de nuevo.'); b.textContent = rotulo; b.disabled = false; return; }
            const r = await fetch('/api/admin/product', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'encuadre', id, image_url: urlRecorte, image_original_url: src }),
            });
            if (r.ok) { recordarProducto(id); location.reload(); return; }
            const o = await r.json().catch(() => ({}));
            alert((o && o.error) || 'No se pudo guardar el encuadre.');
            b.textContent = rotulo; b.disabled = false;
          });
        } catch {
          alert('No se pudo abrir esa foto para encuadrarla. Puede que la imagen ya no exista.');
        }
      });
    });

    // ---- interruptor de CUIT + contraseña ----
    // Encenderlo deja afuera a toda cuenta sin contraseña, y NO se nota en el momento: las
    // sesiones abiertas duran 90 días. Por eso el servidor se niega la primera vez y hay que
    // confirmar sabiendo a quiénes afecta.
    document.getElementById('codeSwitch')?.addEventListener('click', async () => {
      const btn = document.getElementById('codeSwitch');
      const msg = document.getElementById('codeMsg');
      const encender = btn.dataset.on !== '1';
      const pedir = async (confirmado) => {
        const r = await fetch('/api/admin/settings', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ require_code: encender, ...(confirmado ? { confirmo_lockout: true } : {}) }),
        });
        return { r, o: await r.json().catch(() => ({})) };
      };
      btn.disabled = true; msg.textContent = '';
      try {
        let { r, o } = await pedir(false);
        if (!r.ok && o.necesita_confirmacion) {
          const quienes = (o.cuentas_sin_contrasenia || []).join(', ');
          if (!confirm(o.error + [' ', quienes, ' ', '¿Encender igual?'].join(String.fromCharCode(10)))) {
            btn.disabled = false; return;
          }
          ({ r, o } = await pedir(true));
        }
        if (r.ok) { location.reload(); return; }
        msg.textContent = o.error || 'No se pudo cambiar.';
      } catch { msg.textContent = 'No se pudo conectar.'; }
      btn.disabled = false;
    });

    // ---- envíos: umbral de envío sin cargo por lista ----
    document.getElementById('envSave')?.addEventListener('click', async () => {
      const btn = document.getElementById('envSave');
      const msg = document.getElementById('envMsg');
      const cuerpo = {};
      document.querySelectorAll('.env-monto').forEach((i) => { cuerpo[i.dataset.clave] = i.value; });
      btn.disabled = true; btn.textContent = 'Guardando…';
      try {
        const r = await fetch('/api/admin/settings', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo),
        });
        const o = await r.json().catch(() => ({}));
        if (r.ok) { location.reload(); return; }
        msg.textContent = (o && o.error) || 'No se pudo guardar.';
      } catch { msg.textContent = 'No se pudo conectar.'; }
      btn.disabled = false; btn.textContent = 'Guardar';
    });

    document.querySelectorAll('.ordcard').forEach((card) => {
      const totalEl = card.querySelector('[data-total]');
      const rows = [...card.querySelectorAll('.oi-row')];
      const val = (sel) => { const e = card.querySelector(sel); return e ? e.value : undefined; };
      // ⚠️ El <select> del descuento SOLO se renderiza en pedidos pendientes. En uno confirmado
      // no existe, y `Number(undefined) || 0` daba 0: recompute() recalculaba el total SIN el
      // descuento y lo pintaba en pantalla. Un pedido con −20% se veía por su precio de lista.
      // El `??` es a propósito y no `||`: un descuento de 0 es válido y con `||` caería al dataset.
      const discPct = () => Number(card.querySelector('.disc-sel')?.value ?? card.dataset.pct) || 0;
      const recompute = () => {
        let subtotal = 0;
        rows.forEach((row) => {
          const price = Number(row.dataset.price) || 0;
          const qty = Math.max(0, parseInt(row.querySelector('.qty-edit').value) || 0);
          const line = price * qty;
          subtotal += line;
          row.querySelector('[data-line]').textContent = money(line);
        });
        const total = Math.round(subtotal * (1 - discPct() / 100));
        if (totalEl) totalEl.textContent = money(total);
        // El aviso de envío se recalcula en vivo mientras ella edita cantidades: si no, decía
        // "se le cobra el envío" sobre un total que ya había cambiado en la pantalla.
        // El "Total final" de la tarjeta sigue las cantidades Y los dos montos, en vivo.
        const finalEl = card.querySelector('[data-final]');
        const finalCaja = card.querySelector('[data-final-caja]');
        if (finalEl && finalCaja) {
          // ⚠️ Este parser tiene que hacer LO MISMO que montoEscrito() del servidor. Antes solo
          // sacaba lo no numérico y NO borraba el punto de miles: "8.000" daba 8 en la pantalla
          // y 8.000 en el remito. Un error de mil veces sobre plata, y encima el mensaje de
          // error de la propia API sugiere ese formato ("Por ejemplo: 8000 o 8.000").
          const num = (sel) => {
            const crudo = String(card.querySelector(sel)?.value ?? '');
            const limpio = crudo.replace(/[^0-9,.-]/g, '').replace(/\./g, '').replace(',', '.');
            if (!/[0-9]/.test(limpio)) return 0;
            const n = Number(limpio);
            return Number.isFinite(n) ? n : 0;
          };
          // El saldo NO suma (ver el comentario del markup). Solo el envío.
          const env = num('.of-envio');
          finalCaja.hidden = !env;
          finalEl.textContent = money(total + env);
        }
        const envio = card.querySelector('.ordcard__envio');
        const envioTxt = card.querySelector('[data-envio-txt]');
        if (envio && envioTxt) {
          const umbral = Number(envio.dataset.umbral) || 0;
          const llega = total >= umbral;
          envio.classList.toggle('is-sin', llega);
          envioTxt.textContent = llega
            ? 'Llega a ' + money(umbral) + ': envío sin cargo'
            : 'No llega a ' + money(umbral) + ': se le cobra el envío';
        }
      };
      // Descuento: guarda al instante y recarga (recalcula el total y el remito). Si falla,
      // el selector vuelve al valor que tenía — que no quede mostrando un descuento que no se
      // guardó, porque es plata.
      const selDisc = card.querySelector('.disc-sel');
      if (selDisc) {
        let anterior = selDisc.value;
        selDisc.addEventListener('change', async () => {
          selDisc.disabled = true;
          const r = await fetch('/api/admin/order', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: card.dataset.id, discount_pct: Number(selDisc.value) || 0 }),
          });
          if (r.ok) { location.reload(); return; }
          selDisc.value = anterior;
          selDisc.disabled = false;
          alert('No se pudo aplicar el descuento.');
        });
      }
      card.querySelector('.edit-ord')?.addEventListener('click', () => card.classList.add('editing'));
      card.querySelector('.cancel-ord')?.addEventListener('click', () => {
        // Solo los campos de la ficha editable. Con `querySelectorAll('input')` a secas, tocar
        // Cancelar mientras se edita también le borraba el saldo y el envío recién escritos, que
        // viven fuera de ese bloque. Borrar plata sin avisar no puede ser un efecto colateral.
        card.querySelectorAll('.ordcard__edit input, .qty-edit').forEach((i) => (i.value = i.defaultValue));
        card.classList.remove('editing');
        recompute();
      });
      rows.forEach((row) => row.querySelector('.qty-edit')?.addEventListener('input', recompute));
      card.querySelectorAll('.of-saldo, .of-envio').forEach((i) => i.addEventListener('input', recompute));
      card.querySelector('.save-ord')?.addEventListener('click', async () => {
        const btn = card.querySelector('.save-ord');
        const items = rows.map((row) => ({ id: row.dataset.item, qty: Math.max(0, parseInt(row.querySelector('.qty-edit').value) || 0) }));
        const extra = {
          saldo_anterior: card.querySelector('.of-saldo')?.value ?? '',
          costo_envio: card.querySelector('.of-envio')?.value ?? '',
        };
        btn.textContent = 'Guardando…';
        const r = await fetch('/api/admin/order', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: card.dataset.id, items,
            client_name: val('.of-name'), client_contact: val('.of-contact'),
            delivery_address: val('.of-addr'), delivery_date: val('.of-date'), notes: val('.of-notes'),
            discount_pct: discPct(), ...extra,
          }),
        });
        if (r.ok) location.reload();
        else btn.textContent = 'Error';
      });

      card.querySelector('.del-ord')?.addEventListener('click', async () => {
        const b = card.querySelector('.del-ord');
        const extra = b.dataset.st === 'confirmado' ? ' Se repone el stock que había descontado.' : '';
        if (!confirm('¿Borrar el pedido ' + (b.dataset.num || '') + '?' + extra + ' No se puede deshacer.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/order', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: card.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      });
    });

    // ---- compartir el remito (celular → WhatsApp, sin descargar ni buscar el archivo) ----
    // Se trae el PDF por el proxy (URL firmada, gated por la clave del panel) y se comparte
    // el ARCHIVO en sí. Como el bucket es privado, NO se comparte ninguna URL: si el celular
    // no soporta compartir archivos (desktop / navegadores viejos), se descarga el PDF para
    // que Mica lo adjunte a mano — nunca un link que el cliente no podría abrir.
    document.querySelectorAll('.share-rem').forEach((b) =>
      b.addEventListener('click', async () => {
        const url = b.dataset.url, num = b.dataset.num || 'Remito';
        const original = b.textContent;
        b.disabled = true; b.textContent = 'Preparando…';
        const restore = () => { b.textContent = original; b.disabled = false; };

        let blob;
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error('http ' + res.status);
          blob = await res.blob();
        } catch {
          restore();
          alert('No se pudo preparar el remito. Probá de nuevo.');
          return;
        }

        const file = new File([blob], `${num} - Teia Bakery.pdf`, { type: 'application/pdf' });
        try {
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], title: `Remito ${num}` });
            return restore();
          }
        } catch (e) {
          if (e && e.name === 'AbortError') return restore(); // el usuario cerró el menú
        }

        // Fallback: descargar el PDF (para adjuntarlo a mano). No se comparte ninguna URL.
        try {
          const objUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = objUrl; a.download = `${num} - Teia Bakery.pdf`;
          document.body.appendChild(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(objUrl), 4000);
          b.textContent = '✓ Descargado';
          setTimeout(restore, 2200);
        } catch {
          restore();
          alert('No se pudo descargar el remito.');
        }
      })
    );

    // ---- clientes: cuentas por CUIT (editar datos, borrar) ----
    document.querySelectorAll('.clicard').forEach((card) => {
      const body = card.querySelector('.clicard__body');
      const toggle = card.querySelector('.cli-toggle');
      toggle?.addEventListener('click', () => {
        body.hidden = !body.hidden;
        toggle.textContent = body.hidden ? 'Ver cuenta ▾' : 'Cerrar ▴';
      });

      // Guarda la ficha y devuelve si salió bien. NO recarga: el que llama decide, porque el
      // botón de WhatsApp necesita seguir vivo después de guardar para abrir la hoja de compartir.
      const guardarCuenta = async () => {
        const val = (sel) => { const e = card.querySelector(sel); return e ? e.value : ''; };
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: card.dataset.id,
            business_name: val('.cf-name'), client_contact: val('.cf-contact'),
            delivery_address: val('.cf-addr'), notes: val('.cf-notes'), cuit: val('.cf-cuit'),
            catalog: val('.cf-catalog'), active: val('.cf-active') === '1',
            access_code: val('.cf-code'), // la escribe ella a mano, como el resto
          }),
        });
        const o = await r.json().catch(() => ({}));
        return { ok: r.ok, warning: o && o.warning, error: (o && o.error) || 'No se pudo guardar la cuenta.' };
      };

      // Manda las credenciales por WhatsApp (o las copia si no hay hoja de compartir).
      // GUARDA PRIMERO, siempre. Antes leía los campos sin guardar: se podía escribir una
      // contraseña, tocar este botón y mandársela al comercio sin que quedara nunca en la base
      // — el comercio recibía una clave que no existía y no podía entrar. Ahora el mensaje sale
      // solo si lo que dice ya está guardado.
      card.querySelector('.wa-code')?.addEventListener('click', async () => {
        const boton = card.querySelector('.wa-code');
        const v = (sel) => (card.querySelector(sel)?.value || '').trim();
        const codigo = v('.cf-code');
        if (!codigo) { alert('Escribí la contraseña antes de mandarla: la cuenta no está lista hasta tenerla.'); return; }
        const rotulo = boton.textContent;
        boton.textContent = 'Guardando…'; boton.disabled = true;
        const guardado = await guardarCuenta();
        boton.textContent = rotulo; boton.disabled = false;
        if (!guardado.ok) { alert('No se mandó nada: primero hay que poder guardar la cuenta.\n\n' + guardado.error); return; }
        if (guardado.warning) alert(guardado.warning);
        const appUrl = document.querySelector('.admin-wrap')?.dataset.appUrl || 'https://teia-bakery.vercel.app';
        const texto =
          '¡Hola! 👋 Te damos la bienvenida a Teia Bakery\n\n' +
          'Estas son tus credenciales para acceder:\n\n' +
          // Sin guiones, igual que como lo pide la puerta. Si el mensaje los trae y la
          // pantalla dice "sin guiones", el comercio duda justo donde no tiene que dudar.
          '🔑 CUIT: ' + v('.cf-cuit').replace(/[^0-9]/g, '') + '\n' +
          '🔒 Contraseña: ' + codigo + '\n\n' +
          'Estos son los datos de tu comercio:\n\n' +
          '🏪 Nombre: ' + v('.cf-name') + '\n' +
          '📞 Contacto: ' + v('.cf-contact') + '\n' +
          '📍 Dirección: ' + v('.cf-addr') + '\n\n' +
          '📝 Nota: para entrar, abrí la plataforma de Teia acá 👉 ' + appUrl + '\n' +
          'Ingresás con tu CUIT y la contraseña, y ya ves tu catálogo con precios para hacer el pedido. Cualquier duda, respondé este mismo mensaje. 💛';
        const ok = document.createElement('textarea'); // fallback si clipboard falla (http, permisos)
        const marcarCopiado = () => {
          const msg = card.querySelector('.wa-copied');
          if (msg) { msg.hidden = false; setTimeout(() => (msg.hidden = true), 3200); }
        };

        // PRIMERO compartir DE VERDAD. El botón dice "Enviar por WhatsApp" y antes solo copiaba
        // al portapapeles: Mica lo tocaba, veía "copiado con éxito" y esperaba que le llegara
        // algo — el botón prometía una cosa y hacía otra. Con la hoja de compartir del celular
        // elige WhatsApp y el contacto, y el mensaje sale de una. Es la misma mecánica del botón
        // de compartir el remito, que ya usa.
        if (navigator.share) {
          try {
            await navigator.share({ text: texto });
            return; // se compartió: no hace falta tocar el portapapeles
          } catch (e) {
            // Cerró el menú a propósito: no es un error, y no hay que copiarle nada a sus espaldas.
            if (e && e.name === 'AbortError') return;
            // Cualquier otro fallo (escritorio, permisos): sigue al portapapeles.
          }
        }

        try {
          await navigator.clipboard.writeText(texto);
          marcarCopiado();
        } catch {
          ok.value = texto; ok.style.position = 'fixed'; ok.style.opacity = '0';
          document.body.appendChild(ok); ok.focus(); ok.select();
          const done = document.execCommand && document.execCommand('copy');
          ok.remove();
          if (done) marcarCopiado();
          else alert('No se pudo copiar. Copialo a mano:\n\n' + texto);
        }
      });

      card.querySelector('.save-cli')?.addEventListener('click', async () => {
        const btn = card.querySelector('.save-cli');
        btn.textContent = 'Guardando…'; btn.disabled = true;
        const guardado = await guardarCuenta();
        if (guardado.ok) {
          if (guardado.warning) alert(guardado.warning); // CUIT sin verificador válido: se guarda igual
          location.reload();
        } else {
          alert(guardado.error);
          btn.textContent = 'Guardar cuenta'; btn.disabled = false;
        }
      });
      card.querySelector('.del-cli')?.addEventListener('click', async () => {
        const b = card.querySelector('.del-cli');
        if (!confirm('¿Borrar la cuenta de "' + b.dataset.name + '"? Sus pedidos NO se borran (quedan sin cuenta). No se puede deshacer.')) return;
        b.textContent = '…'; b.disabled = true;
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: card.dataset.id }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Error'; b.disabled = false; }
      });
    });
    const cliform = document.getElementById('cliform');
    if (cliform) {
      const climsg = document.getElementById('climsg');
      cliform.addEventListener('submit', async (e) => {
        e.preventDefault();
        climsg.textContent = 'Creando…';
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            cuit: cliform.elements.namedItem('cuit').value,
            business_name: cliform.elements.namedItem('business_name').value,
            client_contact: cliform.elements.namedItem('client_contact').value,
            catalog: cliform.elements.namedItem('catalog').value,
          }),
        });
        if (r.ok) {
          const o = await r.json().catch(() => ({}));
          if (o && o.warning) alert(o.warning);
          location.hash = 'clientes'; location.reload();
        } else { const o = await r.json().catch(() => ({})); climsg.textContent = (o && o.error) || 'No se pudo crear.'; }
      });
    }

    // ---- modal de detalle de pedido (historial del cliente) ----
    const omodal = document.getElementById('omodal');
    const oEsc = (s) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    function openOrderModal(d) {
      document.getElementById('om-num').textContent = d.num;
      const meta = [d.status, d.date, d.ddate ? 'entrega: ' + d.ddate : '', d.address].filter(Boolean).join(' · ');
      document.getElementById('om-meta').textContent = meta;
      document.getElementById('om-items').innerHTML = (d.items || []).map((it) =>
        `<li><span>${oEsc(it.n)} <small class="muted">${oEsc(it.p || '')}</small></span><span class="muted">× ${it.q}</span><b>${money(it.t)}</b></li>`
      ).join('') || '<li class="muted">Sin detalle de ítems.</li>';
      const pct = Number(d.pct) || 0;
      const sub = (d.items || []).reduce((s, it) => s + (Number(it.t) || 0), 0);
      document.getElementById('om-totals').innerHTML = pct > 0
        ? `<p class="om-line muted"><span>Subtotal</span><b>${money(sub)}</b></p>` +
          `<p class="om-line om-line--disc"><span>Descuento −${pct}%</span><b>−${money(sub - (Number(d.total) || 0))}</b></p>` +
          `<p class="om-line om-line--total"><span>Total</span><b>${money(d.total)}</b></p>`
        : `<p class="om-line om-line--total"><span>Total</span><b>${money(d.total)}</b></p>`;
      const notes = document.getElementById('om-notes');
      notes.hidden = !d.notes;
      if (d.notes) notes.textContent = '📝 ' + d.notes;
      const links = document.getElementById('om-links');
      links.hidden = !d.archived;
      if (d.archived) {
        links.innerHTML = `<a class="arch-link" href="${oEsc(d.rc)}" target="_blank" rel="noopener">📄 Abrir remito</a>`;
      }
      omodal.hidden = false;
    }
    document.querySelectorAll('.oh-view').forEach((b) =>
      b.addEventListener('click', () => { try { openOrderModal(JSON.parse(b.dataset.o)); } catch {} })
    );
    omodal?.querySelectorAll('[data-oclose]').forEach((b) => b.addEventListener('click', () => (omodal.hidden = true)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && omodal && !omodal.hidden) omodal.hidden = true; });

    // ---- rubros / categorías ----
    const catform = document.getElementById('catform');
    if (catform) {
      const catmsg = document.getElementById('catmsg');
      catform.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = catform.elements.namedItem('catname').value.trim();
        if (!name) return;
        catmsg.className = 'muted';
        catmsg.textContent = 'Agregando…';
        const r = await fetch('/api/admin/category', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }),
        });
        if (r.ok) location.reload();
        else { const o = await r.json().catch(() => ({})); catmsg.textContent = (o && o.error) || 'No se pudo agregar.'; }
      });
    }
    document.querySelectorAll('.del-cat').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm('¿Eliminar el rubro "' + b.dataset.name + '"? Los productos que lo usan no se borran.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/category', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: b.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      })
    );

    // deep-link por hash (#pedidos / #clientes / #productos / #nuevo / #rubros)
    // ---- información para el cliente (pestaña Información) ----
    // Guardar edita la fila; el form de abajo crea una nueva. Igual que Rubros, pero editable:
    // esto lo va a cambiar sola cada vez que le cambie el mínimo de envío o los medios de pago.
    document.querySelectorAll('.info-item').forEach((li) => {
      li.querySelector('.save-info')?.addEventListener('click', async (e) => {
        const b = e.currentTarget;
        const q = li.querySelector('.if-q').value.trim();
        const a = li.querySelector('.if-a').value.trim();
        if (!q || !a) { alert('Completá el título y el texto.'); return; }
        b.disabled = true; b.textContent = 'Guardando…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: li.dataset.id, pregunta: q, respuesta: a }),
        });
        if (r.ok) { b.textContent = '✓ Guardado'; setTimeout(() => { b.textContent = 'Guardar'; b.disabled = false; }, 1500); }
        else { const o = await r.json().catch(() => ({})); alert((o && o.error) || 'No se pudo guardar.'); b.textContent = 'Guardar'; b.disabled = false; }
      });
      li.querySelector('.del-info')?.addEventListener('click', async (e) => {
        const b = e.currentTarget;
        if (!confirm('¿Eliminar "' + (b.dataset.name || 'esto') + '"? Deja de verse en el catálogo.')) return;
        b.disabled = true; b.textContent = '…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id: li.dataset.id }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Eliminar'; b.disabled = false; alert('No se pudo eliminar.'); }
      });
    });

    const infoform = document.getElementById('infoform');
    if (infoform) {
      const infomsg = document.getElementById('infomsg');
      infoform.addEventListener('submit', async (e) => {
        e.preventDefault();
        infomsg.className = 'muted';
        infomsg.textContent = 'Agregando…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pregunta: infoform.elements.namedItem('pregunta').value,
            respuesta: infoform.elements.namedItem('respuesta').value,
            sort_order: document.querySelectorAll('.info-item').length,
          }),
        });
        if (r.ok) { location.hash = 'info'; location.reload(); }
        else { const o = await r.json().catch(() => ({})); infomsg.textContent = (o && o.error) || 'No se pudo agregar.'; }
      });
    }

    const initTab = (location.hash || '').slice(1);
    if (['pedidos', 'clientes', 'productos', 'nuevo', 'rubros', 'info'].includes(initTab)) { if (initTab === 'nuevo') resetForm(); showTab(initTab); }

    // ── Volver a la fila donde estaba ────────────────────────────────────────────────────
    // Pedido de Mica: "cada vez que quiero editar algo me vuelve al inicio de pantalla y tengo
    // q volver a buscar el ítem de abajo".
    //
    // Todo lo que toca un producto (guardar, encuadrar, borrar, copiar) termina en
    // location.reload(), y la pestaña reabre ARRIBA DE TODO. Con el catálogo cargado eso es
    // scrollear la lista entera para seguir editando el mismo producto.
    //
    // Se guarda el id ANTES de recargar y se vuelve a él al arrancar. Va en sessionStorage y no
    // en el hash: el hash ya se usa para la pestaña, y si quedara en la URL, recargar a mano
    // saltaría a una fila sin motivo. Se borra apenas se usa, así pasa una sola vez.
    const CLAVE_VOLVER = 'teia:volverAProducto';
    const recordarProducto = (id) => { try { sessionStorage.setItem(CLAVE_VOLVER, String(id)); } catch (e) {} };

    (function volverAlProducto() {
      let id = null;
      try { id = sessionStorage.getItem(CLAVE_VOLVER); sessionStorage.removeItem(CLAVE_VOLVER); } catch (e) {}
      if (!id) return;
      const fila = document.getElementById('prod-' + id);
      if (!fila) return; // lo borró, o cambió de lista: no hay a dónde volver
      showTab('productos');
      // El resaltado dura un rato y se apaga solo: sin él, aterrizar en el medio de una lista
      // larga no dice cuál era la fila.
      fila.classList.add('is-recien');
      setTimeout(() => fila.classList.remove('is-recien'), 2600);
      // ⚠️ ACA HAY DOS TRAMPAS, las dos medidas en el navegador y no deducidas:
      //  1. `behavior:'smooth'` no mueve NADA: Lenis se come el scroll suave nativo.
      //  2. Con scroll nativo instantaneo funciona... una vez de cada dos. Lenis arranca su
      //     bucle despues y devuelve la pagina a cero: es una carrera que se pierde a veces.
      // Por eso se le PIDE A LENIS, que es quien manda sobre el scroll. Si no existe (alguien con
      // "reducir movimiento" activado) se cae a lo nativo instantaneo, que ahi si es confiable.
      // El retraso deja que la pestaña termine de mostrarse: sobre un elemento oculto no hay
      // posicion que calcular.
      setTimeout(() => {
        const lenis = window.__lenis;
        if (lenis && typeof lenis.scrollTo === 'function') lenis.scrollTo(fila, { offset: -140, immediate: true });
        else fila.scrollIntoView({ block: 'center', behavior: 'auto' });
      }, 120);
    })();

    updatePreview();

    // ---- botones de Google según el estado REAL (nada hardcodeado — sobrevive el handoff:
    // con la cuenta nueva conectada, los links apuntan solos a SU Drive y SU planilla) ----
    fetch('/api/admin/google/status')
      .then((r) => (r.ok ? r.json() : null))
      .then((s) => {
        if (!s) return;
        if (!s.connected) { document.getElementById('gConnect').hidden = false; return; }
        if (s.driveUrl) { const a = document.getElementById('gDrive'); a.href = s.driveUrl; a.hidden = false; }
        if (s.sheetUrl) { const a = document.getElementById('gSheet'); a.href = s.sheetUrl; a.hidden = false; }
        // conectado pero sin carpeta/planilla todavía: se crean solas con el primer archivado
      })
      .catch(() => {});
  </script>
</Base>
