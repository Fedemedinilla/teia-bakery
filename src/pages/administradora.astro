---
export const prerender = false;
import Base from '../layouts/Base.astro';
import InstalarApp from '../components/InstalarApp.astro';
import ActivarAvisos from '../components/ActivarAvisos.astro';
import { isTeiaAdmin, redirigirAlIngreso } from '../lib/auth';
import { sbSelect, supaConfigured, env } from '../lib/supabase';
import { fmtCuit } from '../lib/cuit';
import { CATALOGS, catalogOf, catalogLabel, DEFAULT_CATALOG, attrSafe } from '../lib/catalogs';
import { codeRequired } from '../lib/accesscode';
import { DEMO_PRODUCTS, DEMO_ORDERS, DEMO_ORDER_ITEMS, DEMO_CLIENTS } from '../lib/demo';

// Gate: la clave del panel se exige SIEMPRE que esté configurada. Antes se pedía solo si
// Supabase estaba conectado — un deploy sin esas env vars abría el panel entero.
const configured = supaConfigured();
if (!isTeiaAdmin(Astro.request) && env('TEIA_ADMIN_PASSWORD')) {
  return redirigirAlIngreso();
}

// Esta página trae datos de TODOS los clientes (razones sociales, CUITs, precios de las dos
// listas, pedidos). Que ningún caché intermedio ni el del navegador se quede una copia: sin esta
// cabecera, el navegador puede guardarla por heurística y esa copia sobrevive al cierre de sesión.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const products = configured ? await sbSelect('teia_products?order=sort_order.asc,name.asc&select=*') : DEMO_PRODUCTS;
const orders = configured ? await sbSelect('teia_orders?order=created_at.desc&select=*&limit=200') : DEMO_ORDERS;

// Cuentas de clientes (pestaña Clientes): CUIT = comercio, con su descuento y su historial.
const clients = configured ? await sbSelect('teia_clients?order=business_name.asc&select=*') : DEMO_CLIENTS;

// Ítems de cada pedido (para mostrar QUÉ se pidió + editar cantidades).
const orderIds = (orders as any[]).map((o) => o.id);
const orderItems = configured
  ? (orderIds.length ? await sbSelect(`teia_order_items?order_id=in.(${orderIds.join(',')})&select=*&order=id.asc`) : [])
  : DEMO_ORDER_ITEMS;
const itemsByOrder: Record<string, any[]> = {};
for (const it of orderItems as any[]) { (itemsByOrder[it.order_id] ||= []).push(it); }

// Marca si el pedido ya tiene sus remitos archivados (links vs botón "Reintentar").
const orderRows = (orders as any[]).map((o) => ({ ...o, archived: o.archive_status === 'archivado' && !!o.remito_cliente_url }));

// Historial por cuenta (de los 200 pedidos más recientes ya traídos).
const ordersByClient: Record<string, any[]> = {};
for (const o of orderRows) { if (o.client_id) (ordersByClient[o.client_id] ||= []).push(o); }

const money = (n: any) => '$' + Number(n || 0).toLocaleString('es-AR');

// Stock flags precomputed (Astro can't mix `<=` with adjacent JSX).
// otherCatalog/otherLabel: el catálogo "de enfrente", para el botón "Copiar a …" (clonar un
// producto al otro catálogo cambiándole solo el precio, sin recargarlo a mano).
const productRows = (products as any[]).map((p) => {
  const cat = catalogOf(p.catalog);
  const other = CATALOGS.find((k) => k.slug !== cat) || CATALOGS[0];
  return {
    ...p,
    isOut: Number(p.stock) <= 0,
    isLow: Number(p.stock) > 0 && Number(p.stock) <= Number(p.low_stock_threshold),
    otherCatalog: other.slug,
    otherLabel: other.label,
  };
});

// Rubros/categorías (gestionables en la pestaña Rubros); fallback a los defaults en demo.
const categories = configured
  ? await sbSelect('teia_categories?order=sort_order.asc,name.asc&select=*')
  : [{ id: 1, name: 'Tortas' }, { id: 2, name: 'Postres' }, { id: 3, name: 'Salados' }, { id: 4, name: 'Panadería' }];
const catNames = (categories as any[]).map((c) => c.name);

// Segundo factor: solo se PIDE al entrar si TEIA_REQUIRE_CODE=true. El panel lo administra
// igual aunque esté apagado, para tener los códigos listos antes de encenderlo.
const requireCode = codeRequired();
const sinCodigo = (clients as any[]).filter((c) => !c.access_code).length;

// URL pública de la app para el mensaje de bienvenida al cliente. Sale de la env, así que
// tras el handoff a un dominio propio el link del mensaje apunta solo al dominio nuevo.
const appUrl = (env('TEIA_APP_URL') || 'https://teia-bakery.vercel.app').replace(/\/+$/, '');

// Pedidos esperando acción → el número del globo sobre el ícono de la app. Se recalcula acá en
// cada carga del panel, así que confirmar o borrar un pedido lo baja solo.
const pendientes = (orders as any[]).filter((o) => o.status === 'pendiente').length;

// Información para el cliente (pagos, envíos, duración). sbSelect y NO la variante estricta a
// propósito: si la tabla todavía no existe, devuelve [] y el panel abre igual con la pestaña
// vacía. Una feature nueva no puede voltear el panel entero por un SQL que falta correr.
const info = configured ? await sbSelect('teia_info?order=sort_order.asc,id.asc&select=*') : [];

---
<Base title="Administradora — Teia Bakery" app="admin">
  <div class="container admin-wrap" data-app-url={appUrl} data-pendientes={String(pendientes)}>
    <div class="brand brand--fila">
      <img class="brand__logo" src="/logo-teia.png" alt="Teia Bakery" width="2432" height="273" />
      <span>Administradora</span>
    </div>
    <h1 style="margin-bottom:6px">Panel</h1>

    <InstalarApp app="admin" />
    <ActivarAvisos />
    {/* Estado del globo del ícono. Se llena desde el script; oculto si no hay nada que decir. */}
    <p class="muted" id="badgeEstado" style="margin:-8px 0 14px;font-size:12.5px" hidden></p>

    {!configured && <p class="card" style="margin-bottom:12px">🧪 <b>Modo demo</b> — datos de ejemplo. Conectá Supabase + la clave para el panel real.</p>}

    <p class="links-row">
      {CATALOGS.map((c) => (
        <a class="btn" href={`/catalogo?ver=${c.slug}`} target="_blank" rel="noopener">🛍️ Ver {c.label}</a>
      ))}
      <a class="btn btn--ghost" id="gDrive" href="#" target="_blank" rel="noopener" hidden>📁 Remitos en Drive</a>
      <a class="btn btn--ghost" id="gSheet" href="#" target="_blank" rel="noopener" hidden>📊 Planilla</a>
      <a class="btn btn--ghost" id="gConnect" href="/api/admin/google/start" hidden>🔗 Conectar Google</a>
      <a class="btn btn--ghost" href="mailto:hello@kyndredai.com">🛟 Soporte</a>
      {env('TEIA_ADMIN_PASSWORD') && <button class="btn btn--ghost" type="button" id="salirPanel">🔒 Salir</button>}
    </p>

    <div class="tabs" role="tablist">
      <button class="tab is-active" data-tab="pedidos" type="button">Pedidos</button>
      <button class="tab" data-tab="clientes" type="button">Clientes</button>
      <button class="tab" data-tab="productos" type="button">Productos</button>
      <button class="tab" data-tab="nuevo" type="button">＋ Nuevo producto</button>
      <button class="tab" data-tab="rubros" type="button">Rubros</button>
      <button class="tab" data-tab="info" type="button">Información</button>
    </div>

    <!-- PEDIDOS -->
    <section class="panel" data-panel="pedidos">
      {orders.length === 0 && <p class="card muted">Sin pedidos todavía.</p>}
      {orderRows.map((o: any) => (
        <div class="card ordcard" data-id={o.id}>
          <div class="ordcard__head">
            <div>
              <span class="ordcard__num">{o.order_number || `#${o.id}`}</span>
              <span class={`badge badge--${o.status === 'confirmado' ? 'ok' : 'wait'}`}>{o.status}</span>
            </div>
            <div class="ordcard__total" data-total>{money(o.total)}</div>
          </div>

          {o.status === 'pendiente' && (
            <label class="ordcard__disc">
              Descuento fiel
              <select class="disc-sel">
                {[0, 5, 10, 15, 20].map((p) => (
                  <option value={p} selected={Number(o.discount_pct) === p}>{p === 0 ? 'Sin descuento' : `−${p}%`}</option>
                ))}
              </select>
              <span class="ordcard__disc-hint">(clientes fieles)</span>
            </label>
          )}
          {o.status !== 'pendiente' && Number(o.discount_pct) > 0 && (
            <div class="ordcard__disc ordcard__disc--applied">✓ Descuento fiel −{o.discount_pct}% aplicado</div>
          )}

          <div class="ordcard__view">
            <div class="muted ordcard__cli">{o.client_name} · {o.client_contact}</div>
            {o.delivery_address && <div class="muted ordcard__cli">📍 {o.delivery_address}</div>}
            {o.delivery_date && <div class="muted ordcard__cli">🗓️ Entrega: {o.delivery_date}</div>}
            {o.notes && <div class="muted ordcard__cli">📝 {o.notes}</div>}
          </div>

          <div class="ordcard__edit">
            <div class="grid2">
              <div><label>Cliente</label><input class="of-name" value={attrSafe(o.client_name)} /></div>
              <div><label>Contacto</label><input class="of-contact" value={attrSafe(o.client_contact)} /></div>
            </div>
            <label>Dirección de entrega</label>
            <input class="of-addr" value={attrSafe(o.delivery_address)} />
            <div class="grid2">
              <div><label>Día de entrega</label><input class="of-date" type="date" value={o.delivery_date || ''} /></div>
              <div><label>Notas</label><input class="of-notes" value={attrSafe(o.notes)} /></div>
            </div>
          </div>

          <ul class="ordcard__items">
            {(itemsByOrder[o.id] || []).map((it: any) => (
              <li class="oi-row" data-item={it.id} data-price={it.unit_price}>
                <span class="oi-name">{it.name} <small class="muted">{it.pack_label}</small></span>
                <span class="oi-qty">
                  <span class="qty-view">{it.qty}</span>
                  <input class="qty-edit" type="number" min="0" value={it.qty} aria-label={attrSafe(`Cantidad de ${it.name}`)} />
                  <span class="muted"> × {money(it.unit_price)}</span>
                </span>
                <span class="oi-line" data-line>{money(it.line_total)}</span>
              </li>
            ))}
            {(itemsByOrder[o.id] || []).length === 0 && <li class="muted">Sin detalle de ítems.</li>}
          </ul>

          {o.status === 'confirmado' && (
            <div class="ordcard__arch">
              {o.archived && <span class="arch arch--ok">✓ Remito</span>}
              {o.archived && <a class="arch-link" href={`/api/admin/remito?id=${o.id}`} target="_blank" rel="noopener">📄 Abrir</a>}
              {o.archived && (
                <button class="btn btn--ghost share-rem" type="button"
                  data-url={`/api/admin/remito?id=${o.id}`} data-num={o.order_number || `#${o.id}`}>📤 Compartir</button>
              )}
              {!o.archived && <span class="arch arch--err">⚠️ Sin archivar{o.archive_error ? `: ${o.archive_error}` : ''}</span>}
              {!o.archived && <button class="btn btn--ghost retry-arch" type="button" data-id={o.id}>Reintentar</button>}
            </div>
          )}

          <div class="ordcard__actions">
            {o.status === 'pendiente' && <button class="btn btn--ghost edit-ord" type="button">✏️ Editar pedido</button>}
            {o.status === 'pendiente' && <button class="btn save-ord" type="button">Guardar</button>}
            {o.status === 'pendiente' && <button class="btn btn--ghost cancel-ord" type="button">Cancelar</button>}
            {o.status === 'pendiente' && <button class="btn confirm" data-id={o.id}>Confirmar ✓</button>}
            <button class="btn btn--danger del-ord" type="button" data-num={o.order_number || `#${o.id}`} data-st={o.status}>Borrar</button>
          </div>
        </div>
      ))}
    </section>

    <!-- CLIENTES (cuentas por CUIT) -->
    <section class="panel" data-panel="clientes" hidden>
      {clients.length === 0 && (
        <p class="card muted">Sin cuentas todavía. Dá de alta la primera abajo — sin alta, nadie entra.</p>
      )}

      <p class="card cli-modo">
        {requireCode
          ? <span><b>🔒 Entrada con CUIT + contraseña.</b> Cada comercio necesita su contraseña para entrar la primera vez en cada teléfono.</span>
          : <span><b>🔓 Entrada solo con CUIT.</b> Hoy alcanza el CUIT para entrar: la contraseña se guarda pero todavía no se pide. Podés ir cargándolas igual.</span>}
        {sinCodigo > 0 && <span class="cli-modo__warn"> · {sinCodigo} cuenta{sinCodigo === 1 ? '' : 's'} sin contraseña todavía</span>}
      </p>
      {(clients as any[]).map((c: any) => (
        <div class="card clicard" data-id={c.id}>
          <div class="clicard__head">
            <div>
              <span class="clicard__name">{c.business_name}</span>
              <span class="clicard__cuit">CUIT {fmtCuit(c.cuit)}</span>
            </div>
            <div class="clicard__badges">
              {catalogOf(c.catalog) !== DEFAULT_CATALOG && <span class="vip-chip">{catalogLabel(c.catalog)}</span>}
              {c.active === false && <span class="badge badge--out">de baja</span>}
              <span class="badge badge--wait">{(ordersByClient[c.id] || []).length} pedidos</span>
              <button class="btn btn--ghost cli-toggle" type="button">Ver cuenta ▾</button>
            </div>
          </div>

          <div class="clicard__body" hidden>
            <div class="grid2">
              <div><label>Comercio</label><input class="cf-name" value={attrSafe(c.business_name)} /></div>
              <div><label>Contacto</label><input class="cf-contact" value={attrSafe(c.client_contact)} /></div>
            </div>
            <label>Dirección de entrega</label>
            <input class="cf-addr" value={attrSafe(c.delivery_address)} />
            <div class="grid2">
              <div><label>CUIT</label><input class="cf-cuit" value={fmtCuit(c.cuit)} /></div>
              <div><label>Notas internas</label><input class="cf-notes" value={attrSafe(c.notes)} /></div>
            </div>
            <div class="cf-code-row">
              <div>
                <label>Contraseña</label>
                <input class="cf-code" value={attrSafe(c.access_code)} placeholder="escribila vos" autocomplete="off" />
              </div>
                            <button class="btn btn--ghost wa-code" type="button">💬 Enviar por WhatsApp</button>
              <span class="wa-copied" hidden>✓ Copiado — pegalo en WhatsApp</span>
            </div>
            <div class="grid2">
              <div>
                <label>Catálogo que ve</label>
                <select class="cf-catalog">
                  {CATALOGS.map((k) => (
                    <option value={k.slug} selected={catalogOf(c.catalog) === k.slug}>{k.label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label>Estado</label>
                <select class="cf-active">
                  <option value="1" selected={c.active !== false}>Habilitado (puede pedir)</option>
                  <option value="0" selected={c.active === false}>De baja (no puede entrar)</option>
                </select>
              </div>
            </div>
            <div class="ordcard__actions">
              <button class="btn save-cli" type="button">Guardar cuenta</button>
              <button class="btn btn--danger del-cli" type="button" data-name={attrSafe(c.business_name)}>Borrar cuenta</button>
            </div>

            <p class="clicard__hist-t">Historial de pedidos</p>
            <ul class="clicard__hist">
              {(ordersByClient[c.id] || []).map((o: any) => (
                <li>
                  <button class="oh-view" type="button" data-o={JSON.stringify({
                    num: o.order_number || `#${o.id}`, status: o.status,
                    date: String(o.created_at || '').slice(0, 10), ddate: o.delivery_date || '',
                    address: o.delivery_address || '', total: o.total, pct: o.discount_pct || 0,
                    notes: o.notes || '', archived: o.archived,
                    rc: o.archived ? `/api/admin/remito?id=${o.id}` : '',
                    items: (itemsByOrder[o.id] || []).map((it: any) => ({ n: it.name, p: it.pack_label, q: it.qty, t: it.line_total })),
                  })}>{o.order_number || `#${o.id}`}</button>
                  <span class={`badge badge--${o.status === 'confirmado' ? 'ok' : 'wait'}`}>{o.status}</span>
                  <span class="muted">{String(o.created_at || '').slice(0, 10)}</span>
                  {Number(o.discount_pct) > 0 && <span class="muted">−{o.discount_pct}%</span>}
                  <b>{money(o.total)}</b>
                  {o.archived && <a class="arch-link" href={`/api/admin/remito?id=${o.id}`} target="_blank" rel="noopener">📄 remito</a>}
                </li>
              ))}
              {(ordersByClient[c.id] || []).length === 0 && <li class="muted">Sin pedidos todavía.</li>}
            </ul>
          </div>
        </div>
      ))}

      <div class="card form-card" style="margin-top:14px">
        <h2 style="margin-top:0;font-size:16px">＋ Dar de alta un cliente</h2>
        <p class="hint">
          <b>Solo entran los clientes que cargues acá.</b> Con el CUIT que le des de alta, el
          comercio entra a la tienda y ve el catálogo de la lista que elijas. Sin alta, no ve
          ni los precios.
        </p>
        <form id="cliform">
          <div class="grid2">
            <div><label for="cli-cuit">CUIT</label><input id="cli-cuit" name="cuit" required placeholder="30-12345678-1" autocomplete="off" /></div>
            <div><label for="cli-name">Comercio</label><input id="cli-name" name="business_name" required autocomplete="off" /></div>
          </div>
          <div class="grid2">
            <div><label for="cli-contact">Contacto (WhatsApp o email)</label><input id="cli-contact" name="client_contact" autocomplete="off" /></div>
            <div>
              <label for="cli-catalog">¿Qué catálogo ve?</label>
              <select id="cli-catalog" name="catalog">
                {CATALOGS.map((k) => <option value={k.slug}>{k.label}</option>)}
              </select>
            </div>
          </div>
          <div class="form-actions"><button class="btn" type="submit">Dar de alta</button></div>
          <p id="climsg" class="muted"></p>
        </form>
      </div>
    </section>

    <!-- modal de detalle de pedido (se abre desde el historial de cada cliente) -->
    <div class="pmodal" id="omodal" hidden>
      <div class="pmodal__backdrop" data-oclose></div>
      <div class="pmodal__card" role="dialog" aria-modal="true">
        <button class="pmodal__x" type="button" data-oclose aria-label="Cerrar">×</button>
        <div class="pmodal__body">
          <h3 id="om-num"></h3>
          <p class="muted" id="om-meta" style="margin:4px 0 0"></p>
          <ul class="om-items" id="om-items"></ul>
          <div id="om-totals"></div>
          <p class="muted" id="om-notes" hidden></p>
          <p id="om-links" hidden style="margin-top:10px"></p>
        </div>
      </div>
    </div>

    <!-- PRODUCTOS -->
    <section class="panel" data-panel="productos" hidden>
      <div class="card">
        <div class="table-scroll">
        <table>
          <thead><tr><th>Producto</th><th>Catálogo</th><th>Rubro</th><th>Pack</th><th>Precio</th><th>Stock</th><th></th></tr></thead>
          <tbody>
            {productRows.map((p: any) => (
              <tr>
                <td data-label="Producto"><span class="td-v">{p.name}{!p.active && <span class="muted"> (oculto)</span>}</span></td>
                <td data-label="Catálogo"><span class="td-v">
                  {catalogOf(p.catalog) === DEFAULT_CATALOG
                    ? <span class="muted">General</span>
                    : <span class="vip-chip">{catalogLabel(p.catalog)}</span>}
                </span></td>
                <td data-label="Rubro" class="muted"><span class="td-v">{p.category || '—'}</span></td>
                <td data-label="Pack"><span class="td-v">{p.pack_label}</span></td>
                <td data-label="Precio"><span class="td-v">{money(p.price)}</span></td>
                <td data-label="Stock"><span class="td-v">
                  {p.stock}{' '}
                  {p.isOut && <span class="badge badge--out">sin stock</span>}
                  {p.isLow && <span class="badge badge--low">poco stock</span>}
                </span></td>
                <td class="prod-actions">
                  <button class="btn btn--ghost editp" data-p={JSON.stringify(p)}>Editar</button>
                  <button class="btn btn--ghost copy-prod" type="button" data-p={JSON.stringify(p)} data-target={p.otherCatalog} data-target-label={p.otherLabel}>⧉ Copiar a {p.otherLabel}</button>
                  <button class="btn btn--danger del-prod" type="button" data-id={p.id} data-name={attrSafe(p.name)}>Borrar</button>
                </td>
              </tr>
            ))}
            {productRows.length === 0 && <tr><td colspan="7" class="muted">Sin productos. Cargá el primero en “＋ Nuevo producto”.</td></tr>}
          </tbody>
        </table>
        </div>
      </div>
    </section>

    <!-- NUEVO / EDITAR -->
    <section class="panel" data-panel="nuevo" hidden>
      <div class="editor">
        <div class="card form-card">
          <h2 id="formTitle" style="margin-top:0">Nuevo producto</h2>
          <form id="pform">
            <input type="hidden" name="id" />

            <label for="pf-name">Nombre</label>
            <input id="pf-name" name="name" required autocomplete="off" />

            <label for="pf-desc">Descripción</label>
            <textarea id="pf-desc" name="description" rows="2" placeholder="Ej: Base de vainilla, frutos rojos frescos." autocomplete="off"></textarea>

            <div class="grid2">
              <div>
                <label for="pf-cat">Rubro</label>
                <select id="pf-cat" name="category">
                  <option value="">— Elegí un rubro —</option>
                  {catNames.map((c) => <option value={c}>{c}</option>)}
                </select>
              </div>
              <div>
                <label for="pf-catalog">Catálogo</label>
                <select id="pf-catalog" name="catalog">
                  {CATALOGS.map((k) => <option value={k.slug}>{k.label}</option>)}
                </select>
              </div>
            </div>
            <p class="hint">¿Falta un rubro? Crealo en la pestaña <b>Rubros</b>. El <b>catálogo</b> define qué clientes lo ven.</p>

            <label>Foto del producto</label>
            <div class="filepick">
              <label class="filebtn" id="pfilebtn" for="pfile">📷 Subir foto</label>
              <input type="file" id="pfile" accept="image/*" />
            </div>
            <input name="image_url" placeholder="…o pegá una URL de imagen" style="margin-top:8px" />
            <p class="hint">Subí un archivo (recomendado) o pegá una URL. Se ajusta y comprime automáticamente.</p>

            <div class="grid2">
              <div><label for="pf-pack">Pack</label><input id="pf-pack" name="pack_label" placeholder="x6, x12, por kg" /></div>
              <div><label for="pf-price">Precio mayorista</label><input id="pf-price" name="price" type="number" step="0.01" min="0" required /></div>
              <div><label for="pf-stock">Stock (packs)</label><input id="pf-stock" name="stock" type="number" min="0" required /></div>
              <div><label for="pf-low">Avisar si baja de</label><input id="pf-low" name="low_stock_threshold" type="number" min="0" value="5" /></div>
            </div>

            <label class="check"><input type="checkbox" name="active" checked /> Visible en el catálogo</label>

            <div class="form-actions">
              <button class="btn" type="submit">Guardar producto</button>
              <button class="btn btn--ghost" type="button" id="pclear">Limpiar</button>
            </div>
            <p id="pmsg" class="muted"></p>
          </form>
        </div>

        <aside class="preview-pane" aria-hidden="true">
          <p class="preview-pane__label">👁 Vista previa</p>
          <p class="preview-section">Así lo verá el cliente · Sección: <b id="pv-cat">—</b></p>
          <div class="preview-stage">
            <div class="item is-preview" id="pv-item">
              <div class="thumb-box">
                <span class="thumb-ph" id="pv-initial">?</span>
                <img class="thumb-img" id="pv-img" hidden alt="" />
              </div>
              <div class="item__info">
                <p class="item__name" id="pv-name">Nombre del producto</p>
                <p class="item__desc" id="pv-desc" hidden></p>
                <div class="item__meta"><span class="pack" id="pv-pack" hidden></span></div>
              </div>
              <div class="item__buy">
                <span class="price" id="pv-price">$0</span>
                <div id="pv-buy"></div>
              </div>
            </div>
            <p class="pv-hidden-note" id="pv-hidden" hidden>🔒 Oculto — no aparece en el catálogo</p>
          </div>
        </aside>
      </div>
    </section>

    <!-- RUBROS -->
    <section class="panel" data-panel="rubros" hidden>
      <div class="card form-card">
        <h2 style="margin-top:0">Rubros (categorías)</h2>
        <p class="hint">Son las secciones del catálogo. Los productos se agrupan por rubro.</p>
        <ul class="rubro-list" id="rubroList">
          {categories.map((c: any) => (
            <li><span>{c.name}</span><button class="btn btn--ghost del-cat" type="button" data-id={c.id} data-name={attrSafe(c.name)}>Eliminar</button></li>
          ))}
          {categories.length === 0 && <li class="muted">Sin rubros todavía.</li>}
        </ul>
        <form id="catform" style="margin-top:16px">
          <label for="cat-name">Nuevo rubro</label>
          <input id="cat-name" name="catname" placeholder="Ej: Sin TACC" autocomplete="off" required />
          <div class="form-actions"><button class="btn" type="submit">Agregar rubro</button></div>
          <p id="catmsg" class="muted"></p>
        </form>
      </div>
    </section>

      <!-- INFORMACIÓN PARA EL CLIENTE -->
      <section class="panel" data-panel="info" hidden>
        <div class="card form-card">
          <h2 style="margin-top:0">Información para tus clientes</h2>
          <p class="hint">
            Medios de pago, envíos, cuánto duran los productos. Aparece al final del catálogo y
            resumida justo antes de que confirmen el pedido. <b>La editás vos</b>: si cambia el
            mínimo para envío sin cargo, lo cambiás acá y listo.
          </p>

          <ul class="info-list">
            {(info as any[]).map((f: any) => (
              <li class="info-item" data-id={f.id}>
                <input class="if-q" value={attrSafe(f.pregunta)} placeholder="Título" />
                <textarea class="if-a" rows="3" placeholder="Texto">{f.respuesta}</textarea>
                <div class="form-actions">
                  <button class="btn save-info" type="button">Guardar</button>
                  <button class="btn btn--danger del-info" type="button" data-name={attrSafe(f.pregunta)}>Eliminar</button>
                </div>
              </li>
            ))}
            {(info as any[]).length === 0 && (
              <li class="muted">Todavía no cargaste nada. Agregá lo primero acá abajo.</li>
            )}
          </ul>

          <form id="infoform" style="margin-top:18px">
            <label for="info-q">Título</label>
            <input id="info-q" name="pregunta" placeholder="Ej: ¿Cuáles son los medios de pago?" autocomplete="off" required />
            <label for="info-a">Texto</label>
            <textarea id="info-a" name="respuesta" rows="3" placeholder="Ej: En efectivo o por transferencia + IVA." required></textarea>
            <div class="form-actions"><button class="btn" type="submit">Agregar</button></div>
            <p id="infomsg" class="muted"></p>
          </form>
        </div>
      </section>
  </div>

  <script>
    // ---- globo del ícono con los pedidos pendientes ----
    // Abrir el panel pone el globo en el número REAL de pedidos que esperan acción (no lo borra
    // por el solo hecho de abrirlo): si entra, mira y no confirma nada, el recordatorio sigue.
    // Al confirmar o borrar un pedido la página recarga y el número baja solo.
    //
    // Callado mientras todo va bien: solo habla si está en la app instalada y AHÍ falla,
    // que es lo único accionable. Pero sin TRAGARSE el error como al principio, cuando un
    // `.catch(() => {})` dejó el problema invisible.
    (async () => {
      const aviso = document.getElementById('badgeEstado');
      const decir = (t) => { if (aviso) { aviso.textContent = t; aviso.hidden = false; } };
      const n = Number(document.querySelector('.admin-wrap')?.dataset.pendientes || 0);

      const instalada =
        window.matchMedia('(display-mode: standalone)').matches ||
        ('standalone' in navigator && navigator.standalone === true);

      // El globo es un extra de la app instalada. Abierto en el navegador NO tiene por qué haberlo,
      // así que no se dice nada: un cartel técnico permanente en el panel es ruido para Mica.
      // Solo se avisa si está en la app instalada Y ahí falla, que es lo único accionable.
      if (!instalada || !('setAppBadge' in navigator)) return;
      try {
        if (n > 0) await navigator.setAppBadge(n); else await navigator.clearAppBadge();
        // OJO: que la llamada resuelva NO garantiza que se vea — en una pestaña común resuelve
        // igual sin dibujar nada. Por eso no se anuncia ningún éxito, solo se reportan fallas.
      } catch (e) {
        decir('Globo del ícono: no se pudo. Motivo: ' + ((e && e.name ? e.name + ' — ' : '') + (e && e.message || e)));
      }
    })();

    // ---- salir del panel ----
    // Va por fetch con JSON (no un form): detrás del proxy de Vercel, el checkOrigin de Astro
    // rechaza los POST con content-type de formulario aunque salgan del propio sitio.
    document.getElementById('salirPanel')?.addEventListener('click', async (e) => {
      const b = e.currentTarget;
      b.disabled = true; b.textContent = 'Saliendo…';
      try {
        await fetch('/api/admin/salir', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      } catch {}
      location.href = '/administradora';
    });

    // ---- tabs ----
    const showTab = (name) => {
      document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('is-active', t.dataset.tab === name));
      document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== name));
    };
    document.querySelectorAll('.tab').forEach((t) =>
      t.addEventListener('click', () => {
        if (t.dataset.tab === 'nuevo') resetForm();
        showTab(t.dataset.tab);
        history.replaceState(null, '', '#' + t.dataset.tab);
      })
    );

    // ---- confirmar pedido ----
    document.querySelectorAll('.confirm').forEach((b) =>
      b.addEventListener('click', async () => {
        b.disabled = true; // doble click acá = stock descontado dos veces
        b.textContent = '…';
        const r = await fetch('/api/admin/confirm', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.dataset.id }),
        });
        if (r.ok) {
          // El server avisa si el pedido superaba el stock o si algo quedó bajo el mínimo —
          // antes esta respuesta se descartaba y la sobreventa era invisible.
          const o = await r.json().catch(() => ({}));
          const avisos = [];
          if (o.shortages && o.shortages.length) avisos.push('⚠️ STOCK INSUFICIENTE (quedó en 0):\n· ' + o.shortages.join('\n· '));
          if (o.low_stock && o.low_stock.length) avisos.push('Queda poco stock: ' + o.low_stock.join(', '));
          if (avisos.length) alert('Pedido confirmado.\n\n' + avisos.join('\n\n'));
          location.reload();
        } else { b.textContent = 'Error — reintentá'; b.disabled = false; }
      })
    );

    // ---- reintentar archivado de remitos ----
    document.querySelectorAll('.retry-arch').forEach((b) =>
      b.addEventListener('click', async () => {
        b.textContent = 'Archivando…'; b.disabled = true;
        const r = await fetch('/api/admin/archive', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: b.dataset.id }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Reintentar'; b.disabled = false; alert('No se pudo archivar. Probá de nuevo.'); }
      })
    );

    // ---- form producto + vista previa en vivo ----
    const form = document.getElementById('pform');
    const F = (n) => form.elements.namedItem(n); // robusto: evita el shadowing de form.name / form.id
    const fileInput = document.getElementById('pfile');
    const fileBtn = document.getElementById('pfilebtn');
    const msg = document.getElementById('pmsg');
    const money = (n) => '$' + Number(n || 0).toLocaleString('es-AR');

    // Redimensiona/comprime la imagen en el navegador antes de subir (evita el límite de 4,5MB
    // de Vercel y hace el catálogo más liviano). Si algo falla, devuelve el archivo original.
    async function resizeImage(file, maxDim = 1400, quality = 0.85) {
      try {
        const bitmap = await createImageBitmap(file);
        let w = bitmap.width, h = bitmap.height;
        if (Math.max(w, h) > maxDim) { const s = maxDim / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(bitmap, 0, 0, w, h);
        if (bitmap.close) bitmap.close();
        const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', quality));
        if (!blob) return file;
        const base = (file.name || 'foto').replace(/\.[^.]+$/, '') || 'foto';
        return new File([blob], base + '.jpg', { type: 'image/jpeg' });
      } catch { return file; }
    }

    function updatePreview() {
      const name = F('name').value.trim();
      const desc = F('description') ? F('description').value.trim() : '';
      const cat = F('category').value.trim();
      const pack = F('pack_label').value.trim();
      const stock = Number(F('stock').value) || 0;
      const active = F('active') ? F('active').checked : true;
      const file = fileInput && fileInput.files && fileInput.files[0];
      const imgSrc = file ? URL.createObjectURL(file) : F('image_url').value.trim();

      const set = (id, txt) => { const e = document.getElementById(id); if (e) e.textContent = txt; };
      set('pv-name', name || 'Nombre del producto');
      set('pv-cat', cat || '—');
      set('pv-price', money(F('price').value));
      set('pv-initial', (name.charAt(0) || '?').toUpperCase());
      const dEl = document.getElementById('pv-desc'); dEl.textContent = desc; dEl.hidden = !desc;
      const pEl = document.getElementById('pv-pack'); pEl.textContent = pack; pEl.hidden = !pack;
      const img = document.getElementById('pv-img');
      if (imgSrc) { img.src = imgSrc; img.hidden = false; } else { img.hidden = true; img.removeAttribute('src'); }
      document.getElementById('pv-buy').innerHTML = stock > 0
        ? '<div class="stepper"><span class="step-btn">−</span><span class="qty">0</span><span class="step-btn">+</span></div>'
        : '<span class="badge-out">Sin stock</span>';
      document.getElementById('pv-item').classList.toggle('is-hidden', !active);
      document.getElementById('pv-hidden').hidden = active;
    }

    function fillForm(p) {
      // si el rubro del producto no está en el dropdown (fue borrado), lo agregamos como opción
      const catSel = F('category');
      if (catSel && p.category && !Array.from(catSel.options).some((o) => o.value === p.category)) {
        catSel.add(new Option(p.category, p.category));
      }
      ['id', 'name', 'description', 'category', 'catalog', 'image_url', 'pack_label', 'price', 'stock', 'low_stock_threshold'].forEach((k) => {
        const el = F(k); if (el) el.value = p[k] ?? '';
      });
      if (F('active')) F('active').checked = p.active !== false;
      if (fileInput) fileInput.value = '';
      if (fileBtn) fileBtn.textContent = '📷 Subir foto';
      updatePreview();
    }
    function resetForm() {
      form.reset();
      document.getElementById('formTitle').textContent = 'Nuevo producto';
      if (fileInput) fileInput.value = '';
      if (fileBtn) fileBtn.textContent = '📷 Subir foto';
      msg.textContent = '';
      updatePreview();
    }

    document.querySelectorAll('.editp').forEach((b) =>
      b.addEventListener('click', () => {
        fillForm(JSON.parse(b.dataset.p));
        document.getElementById('formTitle').textContent = 'Editar producto';
        showTab('nuevo');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      })
    );

    // "Copiar a <otro catálogo>": clona el producto al otro catálogo como NUEVO (id vacío) y
    // deja el form listo con el precio enfocado. Mica solo cambia el precio y guarda — así no
    // tiene que recargar a mano el mismo producto en el catálogo VIP.
    document.querySelectorAll('.copy-prod').forEach((b) =>
      b.addEventListener('click', () => {
        let p; try { p = JSON.parse(b.dataset.p); } catch { return; }
        fillForm({ ...p, id: '', catalog: b.dataset.target });
        document.getElementById('formTitle').textContent =
          'Copia para ' + (b.dataset.targetLabel || 'el otro catálogo') + ' — ajustá el precio y guardá';
        showTab('nuevo');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        const price = document.getElementById('pf-price');
        if (price) { price.focus(); price.select(); }
      })
    );

    document.querySelectorAll('.del-prod').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm('¿Borrar el producto "' + b.dataset.name + '"? No se puede deshacer.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/product', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: b.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      })
    );

    fileInput?.addEventListener('change', () => {
      const f = fileInput.files && fileInput.files[0];
      if (fileBtn) fileBtn.textContent = f ? '✓ Foto lista' : '📷 Subir foto';
      updatePreview();
    });
    form.addEventListener('input', updatePreview);
    document.getElementById('pclear').addEventListener('click', resetForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'muted';
      let image_url = F('image_url').value.trim();
      const file = fileInput && fileInput.files && fileInput.files[0];

      // 1) subir la imagen si eligió un archivo: se comprime y se manda como BASE64 en JSON
      //    (NO multipart — Vercel bloquea el multipart con 403 vía WAF).
      if (file) {
        msg.textContent = 'Procesando imagen…';
        const toUpload = await resizeImage(file);
        const dataUrl = await new Promise((res) => {
          const rd = new FileReader(); rd.onload = () => res(rd.result); rd.onerror = () => res(''); rd.readAsDataURL(toUpload);
        });
        if (!dataUrl) { msg.textContent = 'No se pudo leer la imagen.'; return; }
        msg.textContent = 'Subiendo imagen…';
        let up, uo;
        try {
          up = await fetch('/api/admin/upload', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contentType: toUpload.type, data: dataUrl }),
          });
          uo = await up.json().catch(() => ({}));
        } catch { msg.textContent = 'No se pudo conectar para subir la imagen.'; return; }
        if (up.ok && uo.url) image_url = uo.url;
        else { msg.textContent = (uo && uo.error) || ('No se pudo subir la imagen (código ' + (up ? up.status : '?') + ').'); return; }
      }

      // 2) guardar el producto
      msg.textContent = 'Guardando…';
      const payload = {
        id: F('id').value,
        name: F('name').value.trim(),
        description: F('description').value.trim(),
        category: F('category').value.trim(),
        catalog: F('catalog') ? F('catalog').value : 'general',
        image_url,
        pack_label: F('pack_label').value.trim(),
        price: F('price').value,
        stock: F('stock').value,
        low_stock_threshold: F('low_stock_threshold').value,
        active: F('active') ? F('active').checked : true,
      };
      const r = await fetch('/api/admin/product', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
      if (r.ok) {
        const editing = !!F('id').value;
        msg.className = 'ok-msg';
        msg.textContent = editing ? '✓ Producto actualizado' : '✓ ¡Producto agregado!';
        setTimeout(() => { location.hash = 'productos'; location.reload(); }, 950);
      } else {
        const o = await r.json().catch(() => ({}));
        msg.textContent = (o && o.error) || 'Error al guardar.';
      }
    });

    // ---- editar un pedido (datos + cantidades) ----
    document.querySelectorAll('.ordcard').forEach((card) => {
      const totalEl = card.querySelector('[data-total]');
      const rows = [...card.querySelectorAll('.oi-row')];
      const val = (sel) => { const e = card.querySelector(sel); return e ? e.value : undefined; };
      const discPct = () => Number(card.querySelector('.disc-sel')?.value) || 0;
      const recompute = () => {
        let subtotal = 0;
        rows.forEach((row) => {
          const price = Number(row.dataset.price) || 0;
          const qty = Math.max(0, parseInt(row.querySelector('.qty-edit').value) || 0);
          const line = price * qty;
          subtotal += line;
          row.querySelector('[data-line]').textContent = money(line);
        });
        if (totalEl) totalEl.textContent = money(Math.round(subtotal * (1 - discPct() / 100)));
      };
      // Descuento fiel: guarda al instante y recarga (recalcula el total y el remito). Si falla,
      // el selector vuelve al valor que tenía — que no quede mostrando un descuento que no se
      // guardó, porque es plata.
      const selDisc = card.querySelector('.disc-sel');
      if (selDisc) {
        let anterior = selDisc.value;
        selDisc.addEventListener('change', async () => {
          selDisc.disabled = true;
          const r = await fetch('/api/admin/order', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: card.dataset.id, discount_pct: Number(selDisc.value) || 0 }),
          });
          if (r.ok) { location.reload(); return; }
          selDisc.value = anterior;
          selDisc.disabled = false;
          alert('No se pudo aplicar el descuento.');
        });
      }
      card.querySelector('.edit-ord')?.addEventListener('click', () => card.classList.add('editing'));
      card.querySelector('.cancel-ord')?.addEventListener('click', () => {
        card.querySelectorAll('input').forEach((i) => (i.value = i.defaultValue));
        card.classList.remove('editing');
        recompute();
      });
      rows.forEach((row) => row.querySelector('.qty-edit')?.addEventListener('input', recompute));
      card.querySelector('.save-ord')?.addEventListener('click', async () => {
        const btn = card.querySelector('.save-ord');
        const items = rows.map((row) => ({ id: row.dataset.item, qty: Math.max(0, parseInt(row.querySelector('.qty-edit').value) || 0) }));
        btn.textContent = 'Guardando…';
        const r = await fetch('/api/admin/order', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: card.dataset.id, items,
            client_name: val('.of-name'), client_contact: val('.of-contact'),
            delivery_address: val('.of-addr'), delivery_date: val('.of-date'), notes: val('.of-notes'),
            discount_pct: discPct(),
          }),
        });
        if (r.ok) location.reload();
        else btn.textContent = 'Error';
      });

      card.querySelector('.del-ord')?.addEventListener('click', async () => {
        const b = card.querySelector('.del-ord');
        const extra = b.dataset.st === 'confirmado' ? ' Se repone el stock que había descontado.' : '';
        if (!confirm('¿Borrar el pedido ' + (b.dataset.num || '') + '?' + extra + ' No se puede deshacer.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/order', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: card.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      });
    });

    // ---- compartir el remito (celular → WhatsApp, sin descargar ni buscar el archivo) ----
    // Se trae el PDF por el proxy (URL firmada, gated por la clave del panel) y se comparte
    // el ARCHIVO en sí. Como el bucket es privado, NO se comparte ninguna URL: si el celular
    // no soporta compartir archivos (desktop / navegadores viejos), se descarga el PDF para
    // que Mica lo adjunte a mano — nunca un link que el cliente no podría abrir.
    document.querySelectorAll('.share-rem').forEach((b) =>
      b.addEventListener('click', async () => {
        const url = b.dataset.url, num = b.dataset.num || 'Remito';
        const original = b.textContent;
        b.disabled = true; b.textContent = 'Preparando…';
        const restore = () => { b.textContent = original; b.disabled = false; };

        let blob;
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error('http ' + res.status);
          blob = await res.blob();
        } catch {
          restore();
          alert('No se pudo preparar el remito. Probá de nuevo.');
          return;
        }

        const file = new File([blob], `${num} - Teia Bakery.pdf`, { type: 'application/pdf' });
        try {
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], title: `Remito ${num}` });
            return restore();
          }
        } catch (e) {
          if (e && e.name === 'AbortError') return restore(); // el usuario cerró el menú
        }

        // Fallback: descargar el PDF (para adjuntarlo a mano). No se comparte ninguna URL.
        try {
          const objUrl = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = objUrl; a.download = `${num} - Teia Bakery.pdf`;
          document.body.appendChild(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(objUrl), 4000);
          b.textContent = '✓ Descargado';
          setTimeout(restore, 2200);
        } catch {
          restore();
          alert('No se pudo descargar el remito.');
        }
      })
    );

    // ---- clientes: cuentas por CUIT (editar datos, borrar) ----
    document.querySelectorAll('.clicard').forEach((card) => {
      const body = card.querySelector('.clicard__body');
      const toggle = card.querySelector('.cli-toggle');
      toggle?.addEventListener('click', () => {
        body.hidden = !body.hidden;
        toggle.textContent = body.hidden ? 'Ver cuenta ▾' : 'Cerrar ▴';
      });

      // Guarda la ficha y devuelve si salió bien. NO recarga: el que llama decide, porque el
      // botón de WhatsApp necesita seguir vivo después de guardar para abrir la hoja de compartir.
      const guardarCuenta = async () => {
        const val = (sel) => { const e = card.querySelector(sel); return e ? e.value : ''; };
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: card.dataset.id,
            business_name: val('.cf-name'), client_contact: val('.cf-contact'),
            delivery_address: val('.cf-addr'), notes: val('.cf-notes'), cuit: val('.cf-cuit'),
            catalog: val('.cf-catalog'), active: val('.cf-active') === '1',
            access_code: val('.cf-code'), // la escribe ella a mano, como el resto
          }),
        });
        const o = await r.json().catch(() => ({}));
        return { ok: r.ok, warning: o && o.warning, error: (o && o.error) || 'No se pudo guardar la cuenta.' };
      };

      // Manda las credenciales por WhatsApp (o las copia si no hay hoja de compartir).
      // GUARDA PRIMERO, siempre. Antes leía los campos sin guardar: se podía escribir una
      // contraseña, tocar este botón y mandársela al comercio sin que quedara nunca en la base
      // — el comercio recibía una clave que no existía y no podía entrar. Ahora el mensaje sale
      // solo si lo que dice ya está guardado.
      card.querySelector('.wa-code')?.addEventListener('click', async () => {
        const boton = card.querySelector('.wa-code');
        const v = (sel) => (card.querySelector(sel)?.value || '').trim();
        const codigo = v('.cf-code');
        if (!codigo) { alert('Escribí la contraseña antes de mandarla: la cuenta no está lista hasta tenerla.'); return; }
        const rotulo = boton.textContent;
        boton.textContent = 'Guardando…'; boton.disabled = true;
        const guardado = await guardarCuenta();
        boton.textContent = rotulo; boton.disabled = false;
        if (!guardado.ok) { alert('No se mandó nada: primero hay que poder guardar la cuenta.\n\n' + guardado.error); return; }
        if (guardado.warning) alert(guardado.warning);
        const appUrl = document.querySelector('.admin-wrap')?.dataset.appUrl || 'https://teia-bakery.vercel.app';
        const texto =
          '¡Hola! 👋 Te damos la bienvenida a Teia Bakery\n\n' +
          'Estas son tus credenciales para acceder:\n\n' +
          '🔑 CUIT: ' + v('.cf-cuit') + '\n' +
          '🔒 Contraseña: ' + codigo + '\n\n' +
          'Estos son los datos de tu comercio:\n\n' +
          '🏪 Nombre: ' + v('.cf-name') + '\n' +
          '📞 Contacto: ' + v('.cf-contact') + '\n' +
          '📍 Dirección: ' + v('.cf-addr') + '\n\n' +
          '📝 Nota: para entrar, abrí la plataforma de Teia acá 👉 ' + appUrl + '\n' +
          'Ingresás con tu CUIT y la contraseña, y ya ves tu catálogo con precios para hacer el pedido. Cualquier duda, respondé este mismo mensaje. 💛';
        const ok = document.createElement('textarea'); // fallback si clipboard falla (http, permisos)
        const marcarCopiado = () => {
          const msg = card.querySelector('.wa-copied');
          if (msg) { msg.hidden = false; setTimeout(() => (msg.hidden = true), 3200); }
        };

        // PRIMERO compartir DE VERDAD. El botón dice "Enviar por WhatsApp" y antes solo copiaba
        // al portapapeles: Mica lo tocaba, veía "copiado con éxito" y esperaba que le llegara
        // algo — el botón prometía una cosa y hacía otra. Con la hoja de compartir del celular
        // elige WhatsApp y el contacto, y el mensaje sale de una. Es la misma mecánica del botón
        // de compartir el remito, que ya usa.
        if (navigator.share) {
          try {
            await navigator.share({ text: texto });
            return; // se compartió: no hace falta tocar el portapapeles
          } catch (e) {
            // Cerró el menú a propósito: no es un error, y no hay que copiarle nada a sus espaldas.
            if (e && e.name === 'AbortError') return;
            // Cualquier otro fallo (escritorio, permisos): sigue al portapapeles.
          }
        }

        try {
          await navigator.clipboard.writeText(texto);
          marcarCopiado();
        } catch {
          ok.value = texto; ok.style.position = 'fixed'; ok.style.opacity = '0';
          document.body.appendChild(ok); ok.focus(); ok.select();
          const done = document.execCommand && document.execCommand('copy');
          ok.remove();
          if (done) marcarCopiado();
          else alert('No se pudo copiar. Copialo a mano:\n\n' + texto);
        }
      });

      card.querySelector('.save-cli')?.addEventListener('click', async () => {
        const btn = card.querySelector('.save-cli');
        btn.textContent = 'Guardando…'; btn.disabled = true;
        const guardado = await guardarCuenta();
        if (guardado.ok) {
          if (guardado.warning) alert(guardado.warning); // CUIT sin verificador válido: se guarda igual
          location.reload();
        } else {
          alert(guardado.error);
          btn.textContent = 'Guardar cuenta'; btn.disabled = false;
        }
      });
      card.querySelector('.del-cli')?.addEventListener('click', async () => {
        const b = card.querySelector('.del-cli');
        if (!confirm('¿Borrar la cuenta de "' + b.dataset.name + '"? Sus pedidos NO se borran (quedan sin cuenta). No se puede deshacer.')) return;
        b.textContent = '…'; b.disabled = true;
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: card.dataset.id }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Error'; b.disabled = false; }
      });
    });
    const cliform = document.getElementById('cliform');
    if (cliform) {
      const climsg = document.getElementById('climsg');
      cliform.addEventListener('submit', async (e) => {
        e.preventDefault();
        climsg.textContent = 'Creando…';
        const r = await fetch('/api/admin/client', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            cuit: cliform.elements.namedItem('cuit').value,
            business_name: cliform.elements.namedItem('business_name').value,
            client_contact: cliform.elements.namedItem('client_contact').value,
            catalog: cliform.elements.namedItem('catalog').value,
          }),
        });
        if (r.ok) {
          const o = await r.json().catch(() => ({}));
          if (o && o.warning) alert(o.warning);
          location.hash = 'clientes'; location.reload();
        } else { const o = await r.json().catch(() => ({})); climsg.textContent = (o && o.error) || 'No se pudo crear.'; }
      });
    }

    // ---- modal de detalle de pedido (historial del cliente) ----
    const omodal = document.getElementById('omodal');
    const oEsc = (s) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
    function openOrderModal(d) {
      document.getElementById('om-num').textContent = d.num;
      const meta = [d.status, d.date, d.ddate ? 'entrega: ' + d.ddate : '', d.address].filter(Boolean).join(' · ');
      document.getElementById('om-meta').textContent = meta;
      document.getElementById('om-items').innerHTML = (d.items || []).map((it) =>
        `<li><span>${oEsc(it.n)} <small class="muted">${oEsc(it.p || '')}</small></span><span class="muted">× ${it.q}</span><b>${money(it.t)}</b></li>`
      ).join('') || '<li class="muted">Sin detalle de ítems.</li>';
      const pct = Number(d.pct) || 0;
      const sub = (d.items || []).reduce((s, it) => s + (Number(it.t) || 0), 0);
      document.getElementById('om-totals').innerHTML = pct > 0
        ? `<p class="om-line muted"><span>Subtotal</span><b>${money(sub)}</b></p>` +
          `<p class="om-line om-line--disc"><span>Descuento fiel −${pct}%</span><b>−${money(sub - (Number(d.total) || 0))}</b></p>` +
          `<p class="om-line om-line--total"><span>Total</span><b>${money(d.total)}</b></p>`
        : `<p class="om-line om-line--total"><span>Total</span><b>${money(d.total)}</b></p>`;
      const notes = document.getElementById('om-notes');
      notes.hidden = !d.notes;
      if (d.notes) notes.textContent = '📝 ' + d.notes;
      const links = document.getElementById('om-links');
      links.hidden = !d.archived;
      if (d.archived) {
        links.innerHTML = `<a class="arch-link" href="${oEsc(d.rc)}" target="_blank" rel="noopener">📄 Abrir remito</a>`;
      }
      omodal.hidden = false;
    }
    document.querySelectorAll('.oh-view').forEach((b) =>
      b.addEventListener('click', () => { try { openOrderModal(JSON.parse(b.dataset.o)); } catch {} })
    );
    omodal?.querySelectorAll('[data-oclose]').forEach((b) => b.addEventListener('click', () => (omodal.hidden = true)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && omodal && !omodal.hidden) omodal.hidden = true; });

    // ---- rubros / categorías ----
    const catform = document.getElementById('catform');
    if (catform) {
      const catmsg = document.getElementById('catmsg');
      catform.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = catform.elements.namedItem('catname').value.trim();
        if (!name) return;
        catmsg.className = 'muted';
        catmsg.textContent = 'Agregando…';
        const r = await fetch('/api/admin/category', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }),
        });
        if (r.ok) location.reload();
        else { const o = await r.json().catch(() => ({})); catmsg.textContent = (o && o.error) || 'No se pudo agregar.'; }
      });
    }
    document.querySelectorAll('.del-cat').forEach((b) =>
      b.addEventListener('click', async () => {
        if (!confirm('¿Eliminar el rubro "' + b.dataset.name + '"? Los productos que lo usan no se borran.')) return;
        b.textContent = '…';
        const r = await fetch('/api/admin/category', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id: b.dataset.id }),
        });
        if (r.ok) location.reload();
        else b.textContent = 'Error';
      })
    );

    // deep-link por hash (#pedidos / #clientes / #productos / #nuevo / #rubros)
    // ---- información para el cliente (pestaña Información) ----
    // Guardar edita la fila; el form de abajo crea una nueva. Igual que Rubros, pero editable:
    // esto lo va a cambiar sola cada vez que le cambie el mínimo de envío o los medios de pago.
    document.querySelectorAll('.info-item').forEach((li) => {
      li.querySelector('.save-info')?.addEventListener('click', async (e) => {
        const b = e.currentTarget;
        const q = li.querySelector('.if-q').value.trim();
        const a = li.querySelector('.if-a').value.trim();
        if (!q || !a) { alert('Completá el título y el texto.'); return; }
        b.disabled = true; b.textContent = 'Guardando…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: li.dataset.id, pregunta: q, respuesta: a }),
        });
        if (r.ok) { b.textContent = '✓ Guardado'; setTimeout(() => { b.textContent = 'Guardar'; b.disabled = false; }, 1500); }
        else { const o = await r.json().catch(() => ({})); alert((o && o.error) || 'No se pudo guardar.'); b.textContent = 'Guardar'; b.disabled = false; }
      });
      li.querySelector('.del-info')?.addEventListener('click', async (e) => {
        const b = e.currentTarget;
        if (!confirm('¿Eliminar "' + (b.dataset.name || 'esto') + '"? Deja de verse en el catálogo.')) return;
        b.disabled = true; b.textContent = '…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id: li.dataset.id }),
        });
        if (r.ok) location.reload();
        else { b.textContent = 'Eliminar'; b.disabled = false; alert('No se pudo eliminar.'); }
      });
    });

    const infoform = document.getElementById('infoform');
    if (infoform) {
      const infomsg = document.getElementById('infomsg');
      infoform.addEventListener('submit', async (e) => {
        e.preventDefault();
        infomsg.className = 'muted';
        infomsg.textContent = 'Agregando…';
        const r = await fetch('/api/admin/info', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pregunta: infoform.elements.namedItem('pregunta').value,
            respuesta: infoform.elements.namedItem('respuesta').value,
            sort_order: document.querySelectorAll('.info-item').length,
          }),
        });
        if (r.ok) { location.hash = 'info'; location.reload(); }
        else { const o = await r.json().catch(() => ({})); infomsg.textContent = (o && o.error) || 'No se pudo agregar.'; }
      });
    }

    const initTab = (location.hash || '').slice(1);
    if (['pedidos', 'clientes', 'productos', 'nuevo', 'rubros', 'info'].includes(initTab)) { if (initTab === 'nuevo') resetForm(); showTab(initTab); }

    updatePreview();

    // ---- botones de Google según el estado REAL (nada hardcodeado — sobrevive el handoff:
    // con la cuenta nueva conectada, los links apuntan solos a SU Drive y SU planilla) ----
    fetch('/api/admin/google/status')
      .then((r) => (r.ok ? r.json() : null))
      .then((s) => {
        if (!s) return;
        if (!s.connected) { document.getElementById('gConnect').hidden = false; return; }
        if (s.driveUrl) { const a = document.getElementById('gDrive'); a.href = s.driveUrl; a.hidden = false; }
        if (s.sheetUrl) { const a = document.getElementById('gSheet'); a.href = s.sheetUrl; a.hidden = false; }
        // conectado pero sin carpeta/planilla todavía: se crean solas con el primer archivado
      })
      .catch(() => {});
  </script>
</Base>
