          )}
          <div class="form-actions"><button class="btn" type="button" id="envSave" disabled={ajustesNoLeidos}>Guardar</button></div>
          <p id="envMsg" class="muted"></p>

          {/* Los comercios con monto PROPIO. Solo lectura y FUERA de .env-monto: el botón Guardar
              de arriba manda todo .env-monto a los ajustes de las listas, y esto no es de ninguna
              lista. Existe para que se entienda por qué Chungo Pilar ve otro número que el resto
              de Chungo, y para que cambiar una lista no se lea como "cambié a todos". */}
          <h3 style="margin:22px 0 6px;font-size:15px">Comercios con monto propio</h3>
          {excepciones.length === 0 ? (
            <p class="hint" style="margin:0">
              Ninguno: todos usan el de su lista. Si un comercio necesita otro monto (como Chungo
              Pilar), se lo ponés en su ficha, en la pestaña Clientes.
            </p>
          ) : (
            <>
              <ul class="hint" style="margin:0 0 6px;padding-left:18px">
                {excepciones.map((e) => (
                  <li>
                    <b>{e.nombre}</b>{!e.activo && ' (de baja)'}: {montoEnvio(e.monto)}
                    <span class="muted"> · su lista, {e.lista}: {money(e.montoLista)}</span>
                  </li>
                ))}
