---
export const prerender = false;
import Base from '../layouts/Base.astro';
import InstalarApp from '../components/InstalarApp.astro';
import ActivarAvisos from '../components/ActivarAvisos.astro';
import { isTeiaAdmin, redirigirAlIngreso } from '../lib/auth';
import { sbSelect, sbSelectStrict, supaConfigured, env } from '../lib/supabase';
import { fmtCuit } from '../lib/cuit';
import { CATALOGS, catalogOf, catalogLabel, DEFAULT_CATALOG, attrSafe } from '../lib/catalogs';
import { codeRequiredFrom, normCode } from '../lib/accesscode';
import { readSettingsStrict } from '../lib/settings';
import { pedidosPendientes } from '../lib/push';
import { umbralDe, umbralesTodos, claveUmbral, umbralDelCliente, excepcionesDe } from '../lib/envio';
import { printFileName } from '../lib/google';
import { montoParaCampo } from '../lib/montos';
import { DEMO_PRODUCTS, DEMO_ORDERS, DEMO_ORDER_ITEMS, DEMO_CLIENTS } from '../lib/demo';

// Gate del panel. FALLA CERRADO, y eso es lo importante.
//
// Antes decía `if (!isTeiaAdmin(...) && env('TEIA_ADMIN_PASSWORD'))`: sin la clave configurada la
// condición daba false y esta página se renderizaba ENTERA, sin puerta — con los CUITs, teléfonos,
// direcciones y precios de todos los comercios adentro del HTML. Los endpoints seguían devolviendo
// 401, pero los datos ya habían viajado.
// El riesgo no era teórico: la clienta va a configurar su propio proyecto de Vercel en el traspaso,
// y una env var que se olvida o se escribe mal es la forma más común de que esto pase.
// Ahora, sin clave, no entra nadie: es la falla correcta para una pantalla con datos de terceros.
const configured = supaConfigured();
if (!isTeiaAdmin(Astro.request)) {
  return redirigirAlIngreso();
}

// Esta página trae datos de TODOS los clientes (razones sociales, CUITs, precios de las dos
// listas, pedidos). Que ningún caché intermedio ni el del navegador se quede una copia: sin esta
// cabecera, el navegador puede guardarla por heurística y esa copia sobrevive al cierre de sesión.
Astro.response.headers.set('Cache-Control', 'private, no-store');

const products = configured ? await sbSelect('teia_products?order=sort_order.asc,name.asc&select=*') : DEMO_PRODUCTS;
const orders = configured ? await sbSelect('teia_orders?order=created_at.desc&select=*&limit=200') : DEMO_ORDERS;
// El conteo del globo se pregunta APARTE y sin límite. Antes salía de `orders`, que trae solo los
// últimos 200 y usa la lectura no estricta: si esa consulta fallaba, el panel calculaba 0
// pendientes y el script le BORRABA el globo del ícono — le decía "no tenés nada" justo cuando
// no se pudo averiguar. Con null no se toca nada.
const pendientesReales = configured ? await pedidosPendientes() : 0;

// Cuentas de clientes (pestaña Clientes): CUIT = comercio, con su descuento y su historial.
const clients = configured ? await sbSelect('teia_clients?order=business_name.asc&select=*') : DEMO_CLIENTS;

// Ítems de cada pedido (para mostrar QUÉ se pidió + editar cantidades).
//
// ⚠️ De a TANDAS de pedidos y no todo junto. Supabase corta cada respuesta en 1000 filas (Max rows)
// y lo hace EN SILENCIO: con 200 pedidos de más de 5 líneas en promedio, una sola consulta ordenada
// por id perdía las líneas de los pedidos más NUEVOS, que son justo los pendientes que ella edita.
// 40 pedidos por tanda dejan margen hasta 25 líneas por pedido.
// Y ESTRICTA: con la no estricta una tanda que fallaba daba [], y sus pedidos se veían "sin
// ítems" — con el menú de agregar ofreciendo lo que ya tenían. Ahora se sabe cuáles no se leyeron.
const orderIds = (orders as any[]).map((o) => o.id);
const TANDA_PEDIDOS = 40;
const tandas: any[][] = [];
for (let i = 0; i < orderIds.length; i += TANDA_PEDIDOS) tandas.push(orderIds.slice(i, i + TANDA_PEDIDOS));
const itemsNoLeidos = new Set<string>();
const orderItems = configured
  ? (await Promise.all(tandas.map(async (ids) => {
      const filas = await sbSelectStrict(`teia_order_items?order_id=in.(${ids.join(',')})&select=*&order=id.asc`);
      if (filas === null) { ids.forEach((id) => itemsNoLeidos.add(String(id))); return []; }
      // En el tope, la respuesta vino CORTADA: esos pedidos se muestran como no leídos, no como
      // completos (un pedido a medias ofrecería en el menú lo que ya tiene y daría totales falsos).
      if ((filas as any[]).length >= 1000) {
        console.warn('[teia] una tanda de ítems llegó al tope de 1000 filas: achicar TANDA_PEDIDOS');
        ids.forEach((id) => itemsNoLeidos.add(String(id)));
        return [];
      }
      return filas as any[];
    }))).flat()
  : DEMO_ORDER_ITEMS;
const itemsByOrder: Record<string, any[]> = {};
for (const it of orderItems as any[]) { (itemsByOrder[it.order_id] ||= []).push(it); }

// El total de un pedido tiene que ser la suma de sus líneas con su descuento. Si no cuadra, un
// guardado quedó a medias (una respuesta que se perdió, dos dispositivos a la vez, un Confirmar
// desde el celular en medio de una edición) y el remito sale o salió con ese total. Se avisa en la
// tarjeta: en un pendiente, Guardar lo recalcula desde la base; en un confirmado, hay que revisar
// el remito.
// Con tolerancia de $1 y SIN redondear: el alta guarda la suma tal cual (con centavos si los
// precios los tienen) y la edición redondea. Comparar exacto contra la versión redondeada daba
// falsas alarmas en pedidos que nadie tocó.
const totalDeLineas = (o: any) =>
  (itemsByOrder[o.id] || []).reduce((s: number, it: any) => s + (Number(it.line_total) || 0), 0) * (1 - (Number(o.discount_pct) || 0) / 100);
const totalNoCuadra = (o: any) =>
  configured && !itemsNoLeidos.has(String(o.id)) && Math.abs(Number(o.total) - totalDeLineas(o)) >= 1;
// El mismo producto en dos líneas: el alta lo junta en una y la edición lo rechaza, así que solo
// sale de dos guardados cruzados (el límite documentado en api/admin/order.ts). El total cuadra
// igual —las dos líneas suman—, por eso necesita su propio aviso.
const repetidosEn = (o: any) => {
  const vistos = new Map<string, { name: string; veces: number }>();
  for (const it of itemsByOrder[o.id] || []) {
    if (it.product_id == null) continue;
    const k = String(it.product_id);
    const v = vistos.get(k);
    if (v) v.veces++; else vistos.set(k, { name: it.name, veces: 1 });
  }
  return [...vistos.values()].filter((v) => v.veces > 1);
};
// "Torta aparece 2 veces" / "Torta y Lemon pie aparecen repetidos": con concordancia y el número real.
const textoRepetidos = (rs: { name: string; veces: number }[]) =>
  rs.length === 1
    ? `${rs[0].name} aparece ${rs[0].veces} veces`
    : `${rs.slice(0, -1).map((r) => r.name).join(', ')} y ${rs[rs.length - 1].name} aparecen repetidos`;

// Marca si el pedido ya tiene sus remitos archivados (links vs botón "Reintentar").
//
// `hasRemito` = el PDF ya está en Storage. Es a propósito MÁS ancho que `archived`: si Drive falló,
// el pedido queda en 'error' pero el remito existe y se puede servir. Abrir, Compartir y "Mandar a
// imprimir" se gatean con este, porque justo cuando Google falla es cuando ella más necesita
// mandarle el remito al comercio a mano (antes Abrir y Compartir desaparecían: revisión del 6/10).
// `archived` solo decide el aviso de que falta guardarlo en Drive y el botón Reintentar.
// `printName` es el nombre que ese remito tiene (o tendría) dentro de la carpeta de impresión;
// el script lo compara contra lo que Drive dice que hay para poner el ✓.
const orderRows = (orders as any[]).map((o) => ({
  ...o,
  archived: o.archive_status === 'archivado' && !!o.remito_cliente_url,
  hasRemito: !!o.remito_cliente_url,
  printName: o.remito_cliente_url ? printFileName(o) : null,
}));

// Historial por cuenta (de los 200 pedidos más recientes ya traídos).
const ordersByClient: Record<string, any[]> = {};
for (const o of orderRows) { if (o.client_id) (ordersByClient[o.client_id] ||= []).push(o); }

const money = (n: any) => '$' + Number(n || 0).toLocaleString('es-AR');

// Stock flags precomputed (Astro can't mix `<=` with adjacent JSX).
// otherCatalog/otherLabel: el catálogo "de enfrente", para el botón "Copiar a …" (clonar un
// producto al otro catálogo cambiándole solo el precio, sin recargarlo a mano).
// Duplicados: el mismo NOMBRE dos veces en la MISMA lista. Pasa al usar "Copiar a…" sobre un
// producto que ya existe del otro lado — antes se creaba una segunda fila en silencio y el
// comercio lo veía repetido en el catálogo, sin que nada avisara. Se marcan para poder borrarlos.
// La comparación ignora mayúsculas, acentos y espacios de más: "Alfajor  de Almendras" y
// "alfajor de almendras" son el mismo producto aunque la base los vea distintos.
const claveProducto = (nombre: any, cat: any) =>
  catalogOf(cat) + '|' + String(nombre ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '')
    .toLowerCase().replace(/\s+/g, ' ').trim();
const cuentaPorClave = new Map<string, number>();
for (const p of products as any[]) {
  const k = claveProducto(p.name, p.catalog);
  cuentaPorClave.set(k, (cuentaPorClave.get(k) || 0) + 1);
}
const duplicados = [...cuentaPorClave.values()].filter((n) => n > 1).length;

const productRows = (products as any[]).map((p) => {
  const cat = catalogOf(p.catalog);
  const other = CATALOGS.find((k) => k.slug !== cat) || CATALOGS[0];
  return {
    ...p,
    isOut: Number(p.stock) <= 0,
    isLow: Number(p.stock) > 0 && Number(p.stock) <= Number(p.low_stock_threshold),
    otherCatalog: other.slug,
    otherLabel: other.label,
    esDuplicado: (cuentaPorClave.get(claveProducto(p.name, p.catalog)) || 0) > 1,
    // Los nombres que YA existen en la lista de enfrente: sirve para avisar antes de copiar.
    yaEstaEnLaOtra: (cuentaPorClave.get(claveProducto(p.name, other.slug)) || 0) > 0,
  };
});

// Rubros/categorías (gestionables en la pestaña Rubros); fallback a los defaults en demo.
const categories = configured
  ? await sbSelect('teia_categories?order=sort_order.asc,name.asc&select=*')
  : [{ id: 1, name: 'Tortas' }, { id: 2, name: 'Postres' }, { id: 3, name: 'Salados' }, { id: 4, name: 'Panadería' }];
const catNames = (categories as any[]).map((c) => c.name);

// ── Orden de la lista de Productos ────────────────────────────────────────────────────────
// Pedido de Mica: "hay forma de que en la parte de productos queden ordenados o por categorías
// y abajo todos los duplicados de chungo? ... está todo medio mezclado".
//
// Antes salían por sort_order y nombre, con las dos listas entremezcladas: para encontrar la
// versión de Chungo de un producto había que barrer toda la tabla.
// Ahora: PRIMERO el mayorista general agrupado por rubro, y al final TODO Chungo junto.
// El orden de los rubros es el MISMO que ve el cliente en el catálogo (teia_categories), así
// que la pantalla de ella y la del comercio se leen igual.
const ordenCatalogo = (slug: string) => CATALOGS.findIndex((c) => c.slug === catalogOf(slug));
const ordenRubro = (r: any) => {
  const i = catNames.indexOf(String(r || '').trim());
  return i < 0 ? 9999 : i; // un rubro que no está en la lista va al final, no al principio
};
const productRowsOrdenadas = [...productRows].sort((a, b) =>
  ordenCatalogo(a.catalog) - ordenCatalogo(b.catalog) ||
  ordenRubro(a.category) - ordenRubro(b.category) ||
  String(a.category || '').localeCompare(String(b.category || ''), 'es') ||
  String(a.name || '').localeCompare(String(b.name || ''), 'es')
);

// Cada fila sabe si abre un grupo nuevo, para dibujar el separador una sola vez.
let grupoAnterior = '';
const filasConGrupo = productRowsOrdenadas.map((p) => {
  const grupo = catalogLabel(catalogOf(p.catalog)) + ' · ' + (String(p.category || '').trim() || 'Sin rubro');
  const abre = grupo !== grupoAnterior;
  grupoAnterior = grupo;
  return { ...p, grupo, abreGrupo: abre };
});

// ── "＋ Agregar producto" en un pedido pendiente ──────────────────────────────────────────
// Pedido de Mica (audio del 11/9): cambiar un producto por otro antes de confirmar ("no me queda
// esa torta, le mando esta otra") sin que el comercio tenga que rehacer el pedido.
// El selector ofrece lo MISMO que ese comercio ve en su catálogo: los activos de SU lista,
// agrupados por rubro y en el mismo orden que catalogo.astro, menos lo que ya está en el pedido
// (eso se cambia en su propia línea). Esto es solo el menú: el precio, la lista y si el producto
// sigue activo los vuelve a sacar el servidor de la base al guardar.
// null = no se puede agregar: el pedido no tiene cuenta o la cuenta ya no está, y sin cuenta no
// hay lista de la que sacar el precio. [] = su lista no tiene nada más para ofrecer.
const clientePorId = new Map((clients as any[]).map((c: any) => [String(c.id), c]));
// Armar un pedido (tarea 3): solo para cuentas que existen y están habilitadas. Las que pidieron
// hace poco, primero: el atajo de Pedidos es para el comercio de siempre.
const clientesParaArmar = (clients as any[]).filter((c: any) => c.active !== false)
  .sort((a: any, b: any) => String(b.last_order_at || '').localeCompare(String(a.last_order_at || '')) || String(a.business_name).localeCompare(String(b.business_name), 'es'));
const sePuedeRepetir = (o: any) => o.status !== 'anulado' && o.client_id != null && clientePorId.get(String(o.client_id))?.active !== false && clientePorId.has(String(o.client_id));
const rubroDelCatalogo = (p: any) => String(p.category || 'Otros').trim() || 'Otros';
const ordenRubroCatalogo = (a: string, b: string) => {
  const ia = catNames.indexOf(a), ib = catNames.indexOf(b);
  return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b);
};
const agregablesDe = (o: any) => {
  // Sin sus líneas no se sabe qué ya tiene: el menú ofrecería productos que ya están.
  if (itemsNoLeidos.has(String(o.id))) return null;
  const cuenta = o.client_id == null ? undefined : clientePorId.get(String(o.client_id));
  if (!cuenta) return null;
  const lista = catalogOf(cuenta.catalog);
  const yaEstan = new Set((itemsByOrder[o.id] || []).map((it: any) => String(it.product_id)));
  const grupos = new Map<string, any[]>();
  // `products` ya viene por sort_order y nombre: dentro de cada rubro queda como en el catálogo.
  for (const p of products as any[]) {
    if (p.active !== true || catalogOf(p.catalog) !== lista || yaEstan.has(String(p.id))) continue;
    const rubro = rubroDelCatalogo(p);
    if (!grupos.has(rubro)) grupos.set(rubro, []);
    const stock = Number(p.stock);
    grupos.get(rubro)!.push({
      id: p.id,
      name: p.name,
      pack: p.pack_label || '',
      price: Number(p.price),
      // Un producto sin precio el servidor no lo deja agregar: se muestra igual, apagado y con el
      // motivo, para que no parezca que desapareció de la lista.
      conPrecio: Number(p.price) > 0,
      // El stock es información, no un freno: confirmar tampoco frena, avisa (confirm.ts).
      stockTxt: !Number.isFinite(stock) || stock <= 0 ? 'sin stock' : `stock ${stock}`,
    });
  }
  return [...grupos.keys()].sort(ordenRubroCatalogo).map((rubro) => ({ rubro, items: grupos.get(rubro)! }));
};
const agregablesPorPedido: Record<string, any[] | null> = Object.fromEntries(
  orderRows.filter((o) => o.status === 'pendiente').map((o) => [String(o.id), agregablesDe(o)])
);
// Por qué no hay menú, dicho con la causa real. `clients` viene de la lectura NO estricta: si falló,
// es [] y TODOS los pendientes parecerían "de una cuenta borrada". Con pedidos a la vista, cero
// cuentas es una lectura que falló, no un negocio sin clientes.
const cuentasNoLeidas = configured && !(clients as any[]).length && (orders as any[]).some((o) => o.client_id != null);
// Lo mismo con los productos (lectura no estricta): cero productos con pedidos a la vista es una
// lectura que falló, y el menú diría "no quedan productos de su lista", que es falso.
const productosNoLeidos = configured && !(products as any[]).length && (orders as any[]).length > 0;
const porQueNoSeAgrega = (o: any) =>
  itemsNoLeidos.has(String(o.id))
    ? 'No se pudieron leer los productos de este pedido. Recargá la página para poder agregar.'
    : cuentasNoLeidas
      ? 'No se pudieron leer las cuentas de los comercios. Recargá la página para poder agregar productos.'
      : 'Para agregar productos, el pedido tiene que tener la cuenta de su comercio, y no la encuentro (¿se borró?). Se pueden cambiar las cantidades igual.';


// Segundo factor: solo se PIDE al entrar si TEIA_REQUIRE_CODE=true. El panel lo administra
// igual aunque esté apagado, para tener los códigos listos antes de encenderlo.
// Ajustes que edita Mica (por ahora, los umbrales de envío sin cargo de cada lista).
// ESTRICTA: con la no estricta, una lectura que fallaba daba {} y la pestaña Envíos mostraba los
// montos de fábrica como si fueran los guardados (y el aviso de envío de cada pedido los usaba).
// Ahora se sabe que falló y se dice. El resto del panel sigue con {} como antes.
const ajustesLeidos = await readSettingsStrict();
const ajustesNoLeidos = configured && ajustesLeidos === null;
const ajustes = ajustesLeidos ?? {};
// Sin cuentas o sin ajustes no se sabe el umbral real de cada pedido: la tarjeta no afirma nada.
// (Va DESPUÉS de ajustesNoLeidos: antes, un const usado antes de declararse tira al renderizar.)
const envioNoCalculable = cuentasNoLeidas || ajustesNoLeidos;
const umbrales = umbralesTodos(ajustes);

const requireCode = codeRequiredFrom(ajustes);

// Umbral que le toca a cada cuenta: el PROPIO si lo tiene (hoy, Chungo Pilar) y si no el de su
// lista. Se arma una vez y se consulta por pedido: un pedido sin cuenta (la borraron después) cae
// al de la lista general. `clients` viene de select=*, así que `envio_min` aparece solo cuando la
// columna existe (antes del SQL viene undefined, que umbralDelCliente trata como "sin excepción").
const umbralPorCliente: Record<string, number> = Object.fromEntries(
  (clients as any[]).map((c: any) => [String(c.id), umbralDelCliente(ajustes, c)])
);
const umbralDelPedido = (o: any) => umbralPorCliente[String(o.client_id)] ?? umbralDe(ajustes, 'general');

// Los comercios que NO siguen el monto de su lista, para la pestaña Envíos.
const excepciones = excepcionesDe(ajustes, clients as any[]);
// ¿Ya se corrió el SQL de la columna? Con select=*, si existe la trae TODA fila (null o un número).
// Si falta, el campo de la ficha se muestra deshabilitado con el motivo, en vez de dejarla escribir
// un monto que no se va a poder guardar. En modo demo no aplica.
const hayColumnaEnvio = !configured || !(clients as any[]).length || 'envio_min' in (clients as any[])[0];
// El monto que se muestra en la pestaña Envíos: el 0 no es "$0" sino una regla.
const montoEnvio = (n: number) => (n === 0 ? 'envío sin cargo siempre' : money(n));
// Cuentas HABILITADAS sin contraseña: son las que quedarían afuera si se enciende el modo.
// Se listan por nombre, no solo se cuentan: "2 cuentas" no le dice a Mica a quién llamar.
// normCode y no .trim(): es EXACTAMENTE la función que usa el login para comparar. Una
// contraseña de solo espacios o solo símbolos ("---") pasa un trim pero al entrar queda en nada
// y el comercio no puede entrar. El panel tiene que contar lo mismo que la puerta.
const sinPassword = (clients as any[]).filter((c) => c.active !== false && !normCode(c.access_code));
const sinCodigo = sinPassword.length;

// URL pública de la app para el mensaje de bienvenida al cliente. Sale de la env, así que
// tras el handoff a un dominio propio el link del mensaje apunta solo al dominio nuevo.
const appUrl = (env('TEIA_APP_URL') || 'https://teia-bakery.vercel.app').replace(/\/+$/, '');

// Pedidos esperando acción → el número del globo sobre el ícono de la app. Se recalcula acá en
// cada carga del panel, así que confirmar o borrar un pedido lo baja solo.
// `pendientes` es lo que se muestra en la pantalla (sale de los 200 pedidos que se listan).
// `pendientesReales` es el número del GLOBO: cuenta todos y puede ser null ("no se pudo contar").
// Son dos cosas distintas a propósito, y el globo usa la que no miente.
const pendientes = (orders as any[]).filter((o) => o.status === 'pendiente').length;

// Información para el cliente (pagos, envíos, duración). sbSelect y NO la variante estricta a
// propósito: si la tabla todavía no existe, devuelve [] y el panel abre igual con la pestaña
// vacía. Una feature nueva no puede voltear el panel entero por un SQL que falta correr.
const info = configured ? await sbSelect('teia_info?order=sort_order.asc,id.asc&select=*') : [];

---
<Base title="Administradora — Teia Bakery" app="admin">
  <div class="container admin-wrap" data-app-url={appUrl} data-pendientes={pendientesReales === null ? '' : String(pendientesReales)}>
    <div class="brand brand--fila">
      <img class="brand__logo" src="/logo-teia.png" alt="Teia Bakery" width="2432" height="273" />
      <span>Administradora</span>
    </div>
    <h1 style="margin-bottom:6px">Panel</h1>

    <InstalarApp app="admin" />
    <ActivarAvisos />
    {/* Estado del globo del ícono. Se llena desde el script; oculto si no hay nada que decir. */}
    <p class="muted" id="badgeEstado" style="margin:-8px 0 14px;font-size:12.5px" hidden></p>

    {/* Problemas con la carpeta de impresión. Es lo único que la administradora puede arreglar
        sola, y si no se lo decimos el local deja de recibir remitos sin que nadie se entere. */}
    <p class="card" id="printAviso" style="margin-bottom:12px;color:var(--bad);font-weight:600" hidden></p>

    {!configured && <p class="card" style="margin-bottom:12px">🧪 <b>Modo demo</b> — datos de ejemplo. Conectá Supabase + la clave para el panel real.</p>}

    <p class="links-row">
      {CATALOGS.map((c) => (
        <a class="btn" href={`/catalogo?ver=${c.slug}`} target="_blank" rel="noopener">🛍️ Ver {c.label}</a>
      ))}
      <a class="btn btn--ghost" id="gDrive" href="#" target="_blank" rel="noopener" hidden>📁 Remitos en Drive</a>
      <a class="btn btn--ghost" id="gSheet" href="#" target="_blank" rel="noopener" hidden>📊 Ventas y productos</a>
      <a class="btn btn--ghost" id="gPrint" href="#" target="_blank" rel="noopener" hidden>🖨️ Para imprimir</a>
      <a class="btn btn--ghost" id="gConnect" href="/api/admin/google/start" hidden>🔗 Conectar Google</a>
      <a class="btn btn--ghost" href="mailto:hello@kyndredai.com">🛟 Soporte</a>
      {env('TEIA_ADMIN_PASSWORD') && <button class="btn btn--ghost" type="button" id="salirPanel">🔒 Salir</button>}
    </p>

    <div class="tabs" role="tablist">
      <button class="tab is-active" data-tab="pedidos" type="button">Pedidos</button>
      <button class="tab" data-tab="clientes" type="button">Clientes</button>
      <button class="tab" data-tab="productos" type="button">Productos</button>
      <button class="tab" data-tab="nuevo" type="button">＋ Nuevo producto</button>
      <button class="tab" data-tab="rubros" type="button">Rubros</button>
      <button class="tab" data-tab="info" type="button">Información</button>
      <button class="tab" data-tab="envios" type="button">Envíos</button>
    </div>

    <!-- PEDIDOS -->
    <section class="panel" data-panel="pedidos">
      {/* El pedido que se acaba de armar (lo destapa el script al volver de /administradora/armar). */}
      <p class="armado-ok" role="status" hidden></p>
      {/* Un GET común: abre la página de armar para ese comercio. Sin JS, y dentro del alcance de la app. */}
      {!cuentasNoLeidas && clientesParaArmar.length > 0 && (
        <form class="armar-atajo" action="/administradora/armar" method="get">
          <label>Armar un pedido para
            <select name="c">
              {clientesParaArmar.map((c: any) => <option value={String(c.id)}>{c.business_name}</option>)}
            </select>
          </label>
          <button class="btn" type="submit">🛒 Armar pedido</button>
        </form>
      )}
      {orders.length === 0 && <p class="card muted">Sin pedidos todavía.</p>}
      {orderRows.map((o: any) => (
        <div class="card ordcard" data-id={o.id} data-pct={String(Number(o.discount_pct) || 0)}>
          <div class="ordcard__head">
            <div>
              <span class="ordcard__num">{o.order_number || `#${o.id}`}</span>
              <span class={`badge badge--${o.status === 'confirmado' ? 'ok' : o.status === 'anulado' ? 'anulado' : 'wait'}`}>{o.status}</span>
              {o.placed_by === 'teia' && <span class="badge badge--teia">🛒 cargado por Teia</span>}
            </div>
            <div class="ordcard__total" data-total data-servidor={String(Number(o.total) || 0)}>{money(o.total)}</div>
          </div>

          {/* Un borrado que quedó a mitad de camino. Antes se veía con el ámbar de "pendiente", sin
              explicación; después decía "el stock ya se repuso", y no siempre era cierto: si la
              conexión se cortó justo al anular, no se repuso nada (verificación del 19/9). La
              pantalla no sabe cuál de los casos fue, así que no lo afirma: dice qué revisar. */}
          {o.status === 'anulado' && (
            <p class="ordcard__descuadre">Anulado: se empezó a borrar y no terminó. El stock de sus productos puede haberse repuesto del todo, en parte o nada: revisalo en Productos antes de tocar Borrar (Borrar ya no repone nada).</p>
          )}
          {o.status === 'pendiente' && (
            <label class="ordcard__disc">
              Descuento
              <select class="disc-sel">
                {[0, 5, 10, 15, 20].map((p) => (
                  <option value={p} selected={Number(o.discount_pct) === p}>{p === 0 ? 'Sin descuento' : `−${p}%`}</option>
                ))}
              </select>
              
            </label>
          )}
          {o.status !== 'pendiente' && Number(o.discount_pct) > 0 && (
            <div class="ordcard__disc ordcard__disc--applied">✓ Descuento −{o.discount_pct}% aplicado</div>
          )}

          {/* ¿Este pedido paga envío? Se compara el total YA CON el descuento aplicado, que es el
              criterio de ella: "si con el desc no llegan al mínimo se les cobra el envío".
              El comercio NO ve esto: en su pantalla es imposible saberlo, porque el descuento se
              aplica acá, después de que él manda el pedido.
              SOLO en pendientes: es la ayuda para decidir al confirmar. En un pedido ya confirmado
              la decisión ya se tomó y está en el remito; recalcularla con el monto de HOY la
              contradiría cada vez que ella cambie un monto (pasó al corregir Chungo el 18/9). */}
          {o.status === 'pendiente' && (
            <div class={`ordcard__envio ${!envioNoCalculable && Number(o.total) >= umbralDelPedido(o) ? 'is-sin' : ''}`} data-umbral={envioNoCalculable ? '' : String(umbralDelPedido(o))}>
              {/* Sin las cuentas no se sabe el monto propio de cada comercio (Pilar caería al de la
                  lista general): se dice que no se pudo, en vez de afirmar "llega" en verde. */}
              <span data-envio-txt>{envioNoCalculable ? 'No se pudieron leer los datos del envío: recargá la página para ver si le corresponde envío sin cargo.' : umbralDelPedido(o) === 0
                ? 'Este comercio nunca paga envío: envío sin cargo'
                : Number(o.total) >= umbralDelPedido(o)
                  ? `Llega a ${money(umbralDelPedido(o))}: envío sin cargo`
                  : `No llega a ${money(umbralDelPedido(o))}: se le cobra el envío`}</span>
            </div>
          )}

          {/* Los dos montos que salen en el remito. Van acá, pegados al aviso de arriba, porque
              son las dos puntas de la MISMA decisión: el aviso dice si le cobrás el envío y acá
              ponés cuánto. Separados por la lista de ítems no se leerían juntos. */}
          <div class="ordcard__extra">
            <label>
              <span>Saldo anterior</span>
              {/* montoParaCampo y no String(): un 8000,50 guardado se mostraba "8000.5" y, al volver a
                  leerlo, el punto contaba como miles (80005). */}
              {/* Sin inputmode: el saldo puede ser a favor del comercio ("-3.000") y el teclado
                  decimal del iPhone no tiene signo menos. */}
              <input class="of-saldo" placeholder="—" readonly={o.status !== 'pendiente'}
                     aria-describedby={`me-saldo-${o.id}`} value={montoParaCampo(o.saldo_anterior)} />
              <small class="monto-error" id={`me-saldo-${o.id}`} hidden></small>
            </label>
            <label>
              <span>Costo de envío</span>
              <input class="of-envio" inputmode="decimal" placeholder="—" readonly={o.status !== 'pendiente'}
                     aria-describedby={`me-envio-${o.id}`} value={montoParaCampo(o.costo_envio)} />
              <small class="monto-error" id={`me-envio-${o.id}`} hidden></small>
            </label>
            {/* ⚠️ El saldo NO entra acá. El total final es pedido + envío y nada más — el saldo
                anterior es un recordatorio, no parte de esta venta. Tiene que dar EXACTAMENTE lo
                mismo que remito.ts, o la pantalla y el papel se contradicen sobre plata.
                Y solo se muestra si hay envío cargado: sin envío sería el mismo número que el
                total del pedido, repetido al lado. */}
            <div class="ordcard__final" data-final-caja hidden={!(Number(o.costo_envio) || 0)}>
              <span>Total final</span>
              <b data-final>{money(Number(o.total) + (Number(o.costo_envio) || 0))}</b>
            </div>
          </div>
          {o.status !== 'pendiente' && (Number(o.saldo_anterior) || Number(o.costo_envio)) ? (
            <p class="ordcard__extra-nota">Ya confirmado: estos montos son los que salieron en el remito.</p>
          ) : null}

          <div class="ordcard__view">
            <div class="muted ordcard__cli">{o.client_name} · {o.client_contact}</div>
            {o.delivery_address && <div class="muted ordcard__cli">📍 {o.delivery_address}</div>}
            {o.delivery_date && <div class="muted ordcard__cli">🗓️ Entrega: {o.delivery_date}</div>}
            {o.notes && <div class="muted ordcard__cli">📝 {o.notes}</div>}
          </div>

          <div class="ordcard__edit">
            <div class="grid2">
              <div><label>Cliente</label><input class="of-name" value={attrSafe(o.client_name)} /></div>
              <div><label>Contacto</label><input class="of-contact" value={attrSafe(o.client_contact)} /></div>
            </div>
            <label>Dirección de entrega</label>
            <input class="of-addr" value={attrSafe(o.delivery_address)} />
            <div class="grid2">
              <div><label>Día de entrega</label><input class="of-date" type="date" value={o.delivery_date || ''} /></div>
              {/* <textarea> y no <input>: el comercio escribe las notas en un textarea (con saltos
                  de línea) y un input los borra de su .value pero no de su .defaultValue. Así el
                  panel las daba por "cambiadas" en cada Guardar y las reescribía pegadas. */}
              <div><label>Notas</label><textarea class="of-notes" rows="2">{o.notes || ''}</textarea></div>
            </div>
          </div>

          <ul class="ordcard__items">
            {(itemsByOrder[o.id] || []).map((it: any) => (
              <li class="oi-row" data-item={it.id} data-price={it.unit_price}>
                <span class="oi-name">{it.name} <small class="muted">{it.pack_label}</small></span>
                <span class="oi-qty">
                  <span class="qty-view">{it.qty}</span>
                  <input class="qty-edit" type="number" min="0" value={it.qty} aria-label={attrSafe(`Cantidad de ${it.name}`)} />
                  <span class="muted"> × {money(it.unit_price)}</span>
                </span>
                <span class="oi-line" data-line>{money(it.line_total)}</span>
              </li>
            ))}
            {itemsNoLeidos.has(String(o.id))
              ? <li class="oi-error">⚠️ No se pudieron leer los productos de este pedido. Recargá la página antes de editarlo o confirmarlo.</li>
              : (itemsByOrder[o.id] || []).length === 0 && <li class="muted oi-vacio">Sin detalle de ítems.</li>}
          </ul>
          {totalNoCuadra(o) && (o.status === 'pendiente' ? (
            <p class="ordcard__descuadre">⚠️ El total ({money(o.total)}) no coincide con sus productos ({money(Math.round(totalDeLineas(o)))}): un guardado quedó a medias. Tocá «Editar pedido» y «Guardar» para recalcularlo antes de confirmar.</p>
          ) : (
            <p class="ordcard__descuadre">⚠️ El total ({money(o.total)}) no coincide con sus productos ({money(Math.round(totalDeLineas(o)))}): revisá el remito antes de mandarlo, puede tener mal el total.</p>
          ))}
          {repetidosEn(o).length > 0 && (
            <p class="ordcard__descuadre">⚠️ {textoRepetidos(repetidosEn(o))} en el pedido (se guardó desde dos lugares a la vez).{o.status === 'pendiente' ? ' Editalo y dejá una sola línea.' : ' Revisá el remito.'}</p>
          )}

          {/* Agregar un producto: solo en pendientes y solo se ve en modo edición, porque lo
              agregado viaja con el Guardar del pedido (todo o nada) y Cancelar lo deshace.
              La fila nueva sale del <template>, servido en el HTML: con la CSP estricta el
              panel no puede inyectar estilos, y así la fila clonada lleva las mismas clases. */}
          {o.status === 'pendiente' && (
            <div class="ordcard__add">
              {agregablesPorPedido[String(o.id)] === null ? (
                <p class="muted ordcard__add-nota">{porQueNoSeAgrega(o)}</p>
              ) : agregablesPorPedido[String(o.id)]!.length === 0 ? (
                <p class="muted ordcard__add-nota">{productosNoLeidos
                  ? 'No se pudieron leer los productos. Recargá la página para poder agregar.'
                  : 'No quedan productos activos de su lista para agregar.'}</p>
              ) : (
                <div class="ordcard__add-fila">
                  {/* data-name / data-pack van con encodeURIComponent y no con attrSafe: attrSafe
                      cambia comillas por espacios y la fila "nuevo" mostraba «Torta  Oreo ».
                      Codificado no queda ni `&` ni `:` ni `/`, así que tampoco cae en la excepción
                      de Astro que attrSafe evita (una URL con & que emite cruda). */}
                  <select class="add-prod" aria-label="Producto para agregar">
                    <option value="">＋ Agregar un producto…</option>
                    {agregablesPorPedido[String(o.id)]!.map((g: any) => (
                      <optgroup label={attrSafe(g.rubro)}>
                        {g.items.map((p: any) => (
                          <option value={String(p.id)} data-price={String(p.price)} data-name={encodeURIComponent(p.name ?? '')}
                                  data-pack={encodeURIComponent(p.pack ?? '')} disabled={!p.conPrecio}>
                            {p.name}{p.pack ? ` ${p.pack}` : ''} — {p.conPrecio ? money(p.price) : 'sin precio cargado'} · {p.stockTxt}
                          </option>
                        ))}
                      </optgroup>
                    ))}
                  </select>
                  <input class="add-qty" inputmode="numeric" value="1" aria-label="Cantidad a agregar" />
                  <button class="btn btn--ghost add-btn" type="button">＋ Agregar</button>
                </div>
              )}
              <template class="add-tpl">
                <li class="oi-row oi-row--nueva">
                  {/* El ✕ va en la columna del nombre, que es la única que se achica: en la de la
                      cantidad ensanchaba la fila y en un celular el importe se salía de la tarjeta. */}
                  <span class="oi-name"><button class="oi-quitar" type="button" aria-label="Sacar este producto agregado" title="Sacar">✕</button> <span class="oi-nueva">nuevo</span> <span data-nombre></span> <small class="muted" data-pack></small></span>
                  <span class="oi-qty">
                    <input class="qty-add" inputmode="numeric" aria-label="Cantidad del producto agregado" />
                    <span class="muted" data-precio></span>
                  </span>
                  <span class="oi-line" data-line></span>
                </li>
              </template>
            </div>
          )}

          {o.status === 'confirmado' && (
            <div class="ordcard__arch">
              {o.hasRemito && <span class="arch arch--ok">✓ Remito</span>}
              {o.hasRemito && <a class="arch-link" href={`/api/admin/remito?id=${o.id}`} target="_blank" rel="noopener">📄 Abrir</a>}
              {o.hasRemito && (
                <button class="btn btn--ghost share-rem" type="button"
                  data-url={`/api/admin/remito?id=${o.id}`} data-num={o.order_number || `#${o.id}`}>📤 Compartir</button>
              )}
              {o.hasRemito && (
                <button class="btn btn--ghost print-rem" type="button" data-id={o.id} data-name={attrSafe(o.printName)}
                  title="Lo deja en la carpeta de Drive que imprime el local">🖨️ Mandar a imprimir</button>
              )}
              {/* El ✓ va servido en el HTML con `hidden` y el script solo lo destapa: con la CSP
                  estricta, un nodo creado por JS no recibe el CSS con scope del componente. */}
              {o.hasRemito && <span class="arch arch--ok print-ok" data-name={attrSafe(o.printName)} hidden>✓ en la carpeta</span>}
              {!o.archived && <span class="arch arch--err">{o.hasRemito ? '⚠️ Falta guardarlo en Drive' : '⚠️ Sin archivar'}{o.archive_error ? `: ${o.archive_error}` : ''}</span>}
              {!o.archived && <button class="btn btn--ghost retry-arch" type="button" data-id={o.id}>Reintentar</button>}
            </div>
          )}

          <div class="ordcard__actions">
            {o.status === 'pendiente' && <button class="btn btn--ghost edit-ord" type="button">✏️ Editar pedido</button>}
            {o.status === 'pendiente' && <button class="btn save-ord" type="button">Guardar</button>}
            {o.status === 'pendiente' && <button class="btn btn--ghost cancel-ord" type="button">Cancelar</button>}
            {o.status === 'pendiente' && <button class="btn confirm" data-id={o.id}>Confirmar ✓</button>}
            {/* Repetir: abre el armado precargado con este pedido (productos y cantidades; precios de HOY).
                Un link en la misma ventana: en la app instalada no sale de la app. */}
            {sePuedeRepetir(o) && <a class="btn btn--ghost rep-ord" href={`/administradora/armar?c=${o.client_id}&repetir=${o.id}`}>↻ Repetir</a>}
            {/* data-reponer: lo que Borrar le va a SUMAR al stock, para que el diálogo lo diga con
                números. Un pedido confirmado antes del 19/9 con faltante (el stock frenaba en 0)
                repone de más, y así ella lo ve antes de aceptar. */}
            <button class="btn btn--danger del-ord" type="button" data-num={o.order_number || `#${o.id}`} data-st={o.status}
                    data-reponer={(itemsByOrder[o.id] || []).filter((it: any) => it.product_id).map((it: any) => `${it.name} +${it.qty}`).join(', ')}>Borrar</button>
          </div>
        </div>
      ))}
    </section>

    <!-- CLIENTES (cuentas por CUIT) -->
    <section class="panel" data-panel="clientes" hidden>
      {clients.length === 0 && (
        <p class="card muted">Sin cuentas todavía. Dá de alta la primera abajo — sin alta, nadie entra.</p>
      )}

      <div class="card cli-modo">
        <div class="cli-modo__estado">
          {requireCode
            ? <span><b>🔒 Entrada con CUIT + contraseña.</b> Cada comercio necesita su contraseña para entrar la primera vez en cada teléfono.</span>
            : <span><b>🔓 Entrada solo con CUIT.</b> Hoy alcanza el CUIT para entrar: la contraseña se guarda pero todavía no se pide.</span>}
          <button class="btn btn--ghost" type="button" id="codeSwitch" data-on={requireCode ? '1' : '0'}>
            {requireCode ? 'Volver a solo CUIT' : 'Pedir contraseña'}
          </button>
        </div>

        {sinCodigo > 0 && (
          <p class="cli-modo__warn">
            {requireCode
              ? <b>⚠️ Estas cuentas NO pueden entrar</b>
              : <b>Antes de encender, cargales la contraseña a estas cuentas</b>}
            {' — '}{sinPassword.map((c: any) => c.business_name).join(', ')}
          </p>
        )}
        <p class="muted" id="codeMsg"></p>
      </div>
      {(clients as any[]).map((c: any) => (
        <div class="card clicard" data-id={c.id}>
          <div class="clicard__head">
            <div>
              <span class="clicard__name">{c.business_name}</span>
              <span class="clicard__cuit">CUIT {fmtCuit(c.cuit)}</span>
            </div>
            <div class="clicard__badges">
              {catalogOf(c.catalog) !== DEFAULT_CATALOG && <span class="vip-chip">{catalogLabel(c.catalog)}</span>}
              {c.active === false && <span class="badge badge--out">de baja</span>}
              <span class="badge badge--wait">{(ordersByClient[c.id] || []).length} pedidos</span>
              {c.active !== false && <a class="btn btn--ghost cli-armar" href={`/administradora/armar?c=${c.id}`}>🛒 Armar pedido</a>}
              <button class="btn btn--ghost cli-toggle" type="button">Ver cuenta ▾</button>
            </div>
          </div>

          <div class="clicard__body" hidden>
            <div class="grid2">
              <div><label>Comercio</label><input class="cf-name" value={attrSafe(c.business_name)} /></div>
              <div><label>Contacto</label><input class="cf-contact" value={attrSafe(c.client_contact)} /></div>
            </div>
            <label>Dirección de entrega</label>
            <input class="cf-addr" value={attrSafe(c.delivery_address)} />
            <div class="grid2">
              <div><label>CUIT</label><input class="cf-cuit" value={fmtCuit(c.cuit)} /></div>
              <div><label>Notas internas</label><input class="cf-notes" value={attrSafe(c.notes)} /></div>
            </div>
            <div class="cf-code-row">
              <div>
                <label>Contraseña</label>
                <input class="cf-code" value={attrSafe(c.access_code)} placeholder="escribila vos" autocomplete="off" />
              </div>
                            <button class="btn btn--ghost wa-code" type="button">💬 Enviar por WhatsApp</button>
              <span class="wa-copied" hidden>✓ Copiado — pegalo en WhatsApp</span>
            </div>
            <div class="grid2">
              <div>
                <label>Catálogo que ve</label>
                <select class="cf-catalog">
                  {CATALOGS.map((k) => (
                    <option value={k.slug} selected={catalogOf(c.catalog) === k.slug}>{k.label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label>Estado</label>
                <select class="cf-active">
                  <option value="1" selected={c.active !== false}>Habilitado (puede pedir)</option>
                  <option value="0" selected={c.active === false}>De baja (no puede entrar)</option>
                </select>
              </div>
            </div>
            {/* Envío sin cargo PROPIO de este comercio. Existe por Chungo Pilar ($250.000 en una
                lista de $140.000). `attrSafe` conserva el 0 ("0") y deja '' para null/undefined:
                NUNCA `c.envio_min || ''`, que borraría un 0 y al guardar lo volvería "su lista".
                `data-orig` es para que el panel lo mande SOLO si ella lo tocó. */}
            <div>
              {/* for/id y aria-describedby: sin ellos el lector de pantalla nombraba el campo con el
                  placeholder ("el de su lista") aunque tuviera un monto propio cargado. */}
              <label for={`cf-envio-${c.id}`}>Envío sin cargo desde</label>
              <div class="envio-input">
                <span aria-hidden="true">$</span>
                <input class="cf-envio" id={`cf-envio-${c.id}`} aria-describedby={`cf-envio-ayuda-${c.id}`}
                       inputmode="numeric" autocomplete="off"
                       value={attrSafe(c.envio_min)} data-orig={attrSafe(c.envio_min)}
                       placeholder={`el de su lista (${money(umbralDe(ajustes, c.catalog))})`}
                       disabled={!hayColumnaEnvio} />
              </div>
              <p class="hint" id={`cf-envio-ayuda-${c.id}`} style="margin:4px 0 0">
                {hayColumnaEnvio
                  ? <>Vacío = el de su lista. Poné un monto solo si este comercio es distinto al resto. <b>0 = nunca paga envío.</b></>
                  : <>Todavía no está disponible: falta una actualización de la base de datos. Avisá a soporte (🛟 Soporte, arriba).</>}
              </p>
            </div>
            <div class="ordcard__actions">
              <button class="btn save-cli" type="button">Guardar cuenta</button>
              <button class="btn btn--danger del-cli" type="button" data-name={attrSafe(c.business_name)}>Borrar cuenta</button>
            </div>

            <p class="clicard__hist-t">Historial de pedidos</p>
            <ul class="clicard__hist">
              {(ordersByClient[c.id] || []).map((o: any) => (
                <li>
                  <button class="oh-view" type="button" data-o={JSON.stringify({
                    num: o.order_number || `#${o.id}`, status: o.status,
                    date: String(o.created_at || '').slice(0, 10), ddate: o.delivery_date || '',
                    address: o.delivery_address || '', total: o.total, pct: o.discount_pct || 0,
                    notes: o.notes || '',
                    rc: o.hasRemito ? `/api/admin/remito?id=${o.id}` : '',
                    items: (itemsByOrder[o.id] || []).map((it: any) => ({ n: it.name, p: it.pack_label, q: it.qty, t: it.line_total })),
                  })}>{o.order_number || `#${o.id}`}</button>
                  <span class={`badge badge--${o.status === 'confirmado' ? 'ok' : o.status === 'anulado' ? 'anulado' : 'wait'}`}>{o.status}</span>
              {o.placed_by === 'teia' && <span class="badge badge--teia">🛒 cargado por Teia</span>}
                  <span class="muted">{String(o.created_at || '').slice(0, 10)}</span>
                  {Number(o.discount_pct) > 0 && <span class="muted">−{o.discount_pct}%</span>}
                  <b>{money(o.total)}</b>
                  {o.hasRemito && <a class="arch-link" href={`/api/admin/remito?id=${o.id}`} target="_blank" rel="noopener">📄 remito</a>}
                </li>
              ))}
              {(ordersByClient[c.id] || []).length === 0 && <li class="muted">Sin pedidos todavía.</li>}
            </ul>
