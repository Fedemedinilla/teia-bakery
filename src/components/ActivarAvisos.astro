---
// Botón para que la administradora active los avisos de pedidos nuevos en SU teléfono.
//
// El permiso lo tiene que dar ella tocando el botón: los navegadores exigen que la petición
// salga de un gesto de la persona, y no se puede activar por ella desde el servidor.
//
// En iPhone las notificaciones web SOLO existen dentro de la app instalada en la pantalla de
// inicio. Si todavía no la instaló, no tiene sentido ofrecer el botón: se la manda a instalarla.
//
// Si faltan las claves VAPID, este bloque no se renderiza y no aparece nada.
import { pushConfigured, vapidPublicKey } from '../lib/push';
const activo = pushConfigured();
const clave = vapidPublicKey();
---
{activo && (
  <div class="avisos" data-avisos data-clave={clave} hidden>
    <div class="avisos__txt">
      <p class="avisos__t">Avisos de pedidos nuevos</p>
      <p class="avisos__d" data-avisos-desc></p>
    </div>
    <button class="btn btn--ghost avisos__btn" type="button" data-avisos-probar hidden>Probar</button>
    <button class="btn btn--ghost avisos__btn" type="button" data-avisos-btn hidden></button>
  </div>
)}

<script>
  const caja = document.querySelector('[data-avisos]');
  if (caja) {
    const desc = caja.querySelector('[data-avisos-desc]');
    const btn = caja.querySelector('[data-avisos-btn]');
    const clave = caja.dataset.clave || '';

    const soporta = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
    const instalada =
      window.matchMedia('(display-mode: standalone)').matches ||
      ('standalone' in navigator && navigator.standalone === true);
    const esIOS =
      /iphone|ipad|ipod/i.test(navigator.userAgent) ||
      (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);

    // La clave pública viaja en base64url y el navegador la pide como bytes.
    const aBytes = (base64) => {
      const pad = '='.repeat((4 - (base64.length % 4)) % 4);
      const limpio = (base64 + pad).replace(/-/g, '+').replace(/_/g, '/');
      const bin = atob(limpio);
      return Uint8Array.from([...bin].map((c) => c.charCodeAt(0)));
    };

    const probar = caja.querySelector('[data-avisos-probar]');

    const mostrar = (texto, accion, conPrueba) => {
      desc.textContent = texto;
      if (accion) { btn.textContent = accion; btn.hidden = false; } else { btn.hidden = true; }
      probar.hidden = !conPrueba;
      caja.hidden = false;
    };

    // Traduce el fallo real a algo accionable. Un "no se pudo" a secas no deja diagnosticar nada.
    const explicar = (e) => {
      const n = (e && e.name) || '';
      const m = (e && e.message) || String(e);
      if (n === 'NotAllowedError')
        return 'El navegador bloqueó los avisos para este sitio. Habilitalos en el candado de la barra de direcciones y probá de nuevo.';
      if (n === 'AbortError' || /push service|registration failed/i.test(m))
        return 'El navegador no pudo conectarse al servicio de notificaciones. Suele pasar con VPN, bloqueadores de anuncios o redes que filtran tráfico de Google. Probá desactivándolos, o usá Chrome o Edge.';
      if (n === 'InvalidStateError')
        return 'Había una suscripción vieja con otra clave. Recargá la página y probá de nuevo.';
      if (n === 'NotSupportedError')
        return 'Este navegador no soporta avisos.';
      return 'No se pudieron activar. Motivo: ' + (n ? n + ' — ' : '') + m;
    };

    const estado = async () => {
      if (!soporta || !clave) return; // navegador viejo: no se muestra nada

      // iPhone sin instalar: el permiso no existe fuera de la app de la pantalla de inicio.
      if (esIOS && !instalada) {
        mostrar('Para recibir avisos en el iPhone, primero agregá el panel a tu pantalla de inicio.', null);
        return;
      }
      if (Notification.permission === 'denied') {
        mostrar('Los avisos están bloqueados en este dispositivo. Se habilitan desde los ajustes del navegador.', null);
        return;
      }

      const reg = await navigator.serviceWorker.getRegistration();
      const sub = reg ? await reg.pushManager.getSubscription() : null;
      if (sub) mostrar('Activados en este dispositivo. Te avisamos cuando entre un pedido.', 'Desactivar', true);
      else mostrar('Recibí una notificación en este dispositivo (celular o computadora) cuando entre un pedido.', 'Activar', false);
    };

    // Manda un aviso de prueba a los teléfonos suscriptos, para comprobar que llega de verdad
    // sin tener que inventar un pedido.
    probar.addEventListener('click', async () => {
      probar.disabled = true;
      probar.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/admin/push', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'prueba' }),
        });
        const o = await r.json().catch(() => ({}));
        if (r.ok && o.entregados > 0) {
          probar.textContent = '✓ Enviado';
          desc.textContent = 'Aviso de prueba enviado a ' + o.entregados +
            (o.entregados === 1 ? ' dispositivo.' : ' dispositivos.') + ' Debería aparecer en unos segundos.';
        } else if (r.ok) {
          desc.textContent = 'No se pudo entregar en ningún dispositivo. Probá desactivar y volver a activar.';
          probar.textContent = 'Probar';
        } else {
          desc.textContent = (o && o.error) || 'No se pudo enviar la prueba.';
          probar.textContent = 'Probar';
        }
      } catch {
        desc.textContent = 'No se pudo conectar para enviar la prueba.';
        probar.textContent = 'Probar';
      } finally {
        probar.disabled = false;
        setTimeout(() => { if (probar.textContent === '✓ Enviado') probar.textContent = 'Probar'; }, 4000);
      }
    });

    btn.addEventListener('click', async () => {
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = '…';
      try {
        const reg = await navigator.serviceWorker.ready;
        const actual = await reg.pushManager.getSubscription();

        if (actual) {
          await fetch('/api/admin/push', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'baja', endpoint: actual.endpoint }),
          });
          await actual.unsubscribe();
          await estado();
          return;
        }

        const permiso = await Notification.requestPermission();
        if (permiso !== 'granted') { await estado(); return; }

        const opciones = { userVisibleOnly: true, applicationServerKey: aBytes(clave) };
        let sub;
        try {
          sub = await reg.pushManager.subscribe(opciones);
        } catch (e) {
          // Suscripción vieja hecha con OTRA clave (por ejemplo si se rotaron las VAPID): el
          // navegador se niega a crear una nueva hasta que se descarte la anterior.
          if (e && e.name === 'InvalidStateError') {
            const vieja = await reg.pushManager.getSubscription();
            if (vieja) await vieja.unsubscribe().catch(() => {});
            sub = await reg.pushManager.subscribe(opciones);
          } else {
            throw e;
          }
        }

        const j = sub.toJSON();
        const r = await fetch('/api/admin/push', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint, p256dh: j.keys.p256dh, auth: j.keys.auth }),
        });
        if (!r.ok) {
          const o = await r.json().catch(() => ({}));
          await sub.unsubscribe().catch(() => {}); // no dejarlo suscripto si el server no lo guardó
          await estado();
          desc.textContent = (o && o.error) || 'No se pudieron activar los avisos.';
          btn.textContent = original;
          return;
        }
        await estado();
      } catch (e) {
        // El motivo va A LA VISTA, no en un cartel que se cierra: sin la causa no hay forma de
        // arreglar nada. El texto se puede seleccionar y copiar.
        await estado().catch(() => {});
        desc.textContent = explicar(e);
        btn.textContent = original;
      } finally {
        btn.disabled = false;
      }
    });

    estado();
  }
</script>
