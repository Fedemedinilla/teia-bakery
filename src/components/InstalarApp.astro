---
// Aviso para instalar la app en el celular.
//
// Existe porque instalar NO es descubrible por sí solo: en Android el navegador avisa cuando
// quiere (y el cartel se pierde fácil), y en iPhone NO existe ningún aviso — Apple nunca lo
// implementó, así que hay que ir a Compartir → "Agregar a inicio" a mano. Sin esta ayuda, nadie
// que no sepa de antemano que la app se puede instalar la va a instalar.
//
// Por eso el mensaje difiere según el teléfono:
//   · Android → botón "Instalar" propio, que dispara el instalador del navegador.
//   · iPhone  → invitación corta + link a /instalar, que explica los cuatro pasos con dibujos.
//
// NO se puede cerrar a propósito: si alguien lo cierra una vez, no lo vuelve a ver nunca y pierde
// la app para siempre. Se queda ahí, sin estorbar, hasta que la instale — y ahí se oculta solo.
interface Props {
  /** Cuál de las dos apps: cambia el ícono y el nombre que se menciona. */
  app?: 'cliente' | 'admin';
}
const { app = 'cliente' } = Astro.props;
const esAdmin = app === 'admin';
const icono = esAdmin ? '/icons/admin-192.png' : '/icons/cliente-192.png';
const nombre = esAdmin ? 'Teia Panel' : 'Teia';
// ⚠️ Cada app manda a SU página de instrucciones. Al "Agregar a inicio", iOS instala lo que
// declara la página en la que estás: si el panel linkeara a la página del cliente, seguir los
// pasos ahí instalaría la app equivocada.
const comoInstalar = esAdmin ? '/instalar?app=admin' : '/instalar';
const pregunta = esAdmin
  ? '¿Querés tener el panel en tu pantalla de inicio y abrirlo con un toque?'
  : '¿Querés tener la app de Teia Bakery para hacer tus pedidos más rápido?';
---
<aside class="instalar" data-instalar data-nombre={nombre} data-pregunta={pregunta} hidden>
  <img class="instalar__icono" src={icono} alt="" width="44" height="44" />
  <div class="instalar__txt">
    <p class="instalar__t" data-instalar-titulo>Tenela como app en tu celular</p>
    <p class="instalar__d" data-instalar-desc hidden></p>
    <a class="instalar__link" href={comoInstalar} data-instalar-link hidden>
      {esAdmin ? 'Ver cómo instalarlo →' : 'Ver cómo instalarla →'}
    </a>
  </div>
  <button class="btn instalar__btn" type="button" data-instalar-btn hidden>Instalar</button>
</aside>

<script>
  const caja = document.querySelector('[data-instalar]');
  if (caja) {
    const titulo = caja.querySelector('[data-instalar-titulo]');
    const desc = caja.querySelector('[data-instalar-desc]');
    const link = caja.querySelector('[data-instalar-link]');
    const btn = caja.querySelector('[data-instalar-btn]');
    const nombre = caja.dataset.nombre || 'Teia';

    // Ya está instalada: abierta desde el ícono, no hay nada que ofrecer.
    const yaInstalada =
      window.matchMedia('(display-mode: standalone)').matches ||
      ('standalone' in navigator && navigator.standalone === true);

    // El iPad moderno se declara "Macintosh": se lo reconoce porque además tiene pantalla táctil.
    const esIOS =
      /iphone|ipad|ipod/i.test(navigator.userAgent) ||
      (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);

    if (!yaInstalada) {
      if (esIOS) {
        // iPhone: no hay botón posible. Invitación corta y el paso a paso en su propia página.
        titulo.textContent = caja.dataset.pregunta || '¿Querés tenerla en tu pantalla de inicio?';
        link.hidden = false;
        caja.hidden = false;
      }

      // Android/Chrome: el navegador avisa cuando se puede instalar. Interceptamos ese aviso
      // para ofrecerlo cuando la persona lo entienda, con un botón nuestro.
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        titulo.textContent = 'Tenela como app en tu celular';
        desc.textContent = 'Queda en tu pantalla de inicio como “' + nombre + '” y entrás con un toque.';
        desc.hidden = false;
        link.hidden = true;
        btn.hidden = false;
        caja.hidden = false;
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          e.prompt();
          const r = await e.userChoice.catch(() => null);
          if (r && r.outcome === 'accepted') { caja.hidden = true; return; }
          // Cancelo. `e.prompt()` NO se puede volver a llamar sobre el mismo evento y el
          // listener era { once: true }: volver a habilitar el botón seria dejar uno que no
          // hace nada. Se oculta y se explica el camino manual.
          btn.hidden = true;
          desc.hidden = false;
          desc.textContent = 'Si cambiás de idea, podés instalarla desde el menú del navegador (⋮).';
        }, { once: true });
      });
    }

    window.addEventListener('appinstalled', () => { caja.hidden = true; });
  }
</script>
